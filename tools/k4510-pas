#!/bin/sh
# k4510-pas NAME[.pas]   compile a Mad Pascal program into NAME.prg beside it
# k4510-pas -p PROJECT.K4P   the project's MAIN= (and OUT=)
#
# The on-machine half of "self-hosted Pascal": at the machine's prompt
#   PAS HELLO          (a K/OS word: it runs `!k4510-pas HELLO`)
# compiles HELLO.PAS and leaves HELLO.prg beside it, which HELLO then runs.
# NAME may be a path, and a machine path (/LANG/PASCAL/HELLO) is found under
# K4510_ROOT, the machine's fs/ -- which is how VI's :make compiles the file
# it has open.  The compiler is the cross-compiler the Makefile uses
# (pascal/README.md) -- mp compiles to 6502 assembly, MADS assembles it --
# found where build-live.sh and the Containerfile put it, or where MP_DIR /
# MADS say.  Intermediates go to a scratch directory so the machine's
# folder holds only the source and the program.
#
# Units: `uses myunit` makes mp look for myunit.pas, in lower case, and the
# machine writes its names in capitals.  So mp runs in the scratch
# directory, on lower-case links to every .PAS beside the program: a unit
# next to the program is found whatever case it was saved in.
#
# The messages go to the screen, and -- one line each, in the form
# tools/k4510-errfmt describes -- to /SYSTEM/LOG/MAKE.ERR, which VI reads.
# Exit status is the compiler's, so RC in a REXX script is 0 on success.
set -u
K4510=${K4510:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
MP_DIR=${MP_DIR:-$HOME/Projects/neo6502_dev/Mad-Pascal}
MADS=${MADS:-$HOME/Projects/neo6502_dev/Mad-Assembler/mads}
[ $# -ge 1 ] || { echo "usage: k4510-pas NAME[.pas]   (compiles NAME.pas into NAME.prg beside it)" >&2; exit 2; }
ERR=
[ -n "${K4510_ROOT:-}" ] && [ -d "$K4510_ROOT/SYSTEM/LOG" ] && ERR=$K4510_ROOT/SYSTEM/LOG/MAKE.ERR
[ -n "$ERR" ] && : > "$ERR"
fail() { echo "$1" >&2; [ -n "$ERR" ] && echo "-:0:0:E:$1" >> "$ERR"; exit "${2:-1}"; }
[ -x "$MP_DIR/bin/mp" ] || fail "k4510-pas: no Mad Pascal at $MP_DIR (MP_DIR)" 2
[ -x "$MADS" ] || fail "k4510-pas: no MADS at $MADS (MADS)" 2

# -p PROJECT.K4P: the project's MAIN= is the program (its units come by
# `uses`, from beside it), OUT= its .prg -- PROG's F9 in a project folder
proj=
if [ "$1" = "-p" ]; then [ $# -ge 2 ] || { echo "usage: k4510-pas -p PROJECT.K4P" >&2; exit 2; }; proj=$2; set -- "$2"; fi
src=$1
case "$src" in /*) [ -n "${K4510_ROOT:-}" ] && src=$K4510_ROOT$src ;; esac
cd "$(dirname "$src")" 2>/dev/null || fail "k4510-pas: $(dirname "$1"): no such directory"
src=$(basename "$src")
pout=
if [ -n "$proj" ]; then
    pf=$src; [ -f "$pf" ] || pf=$(find . -maxdepth 1 -iname "$src" | head -1)
    [ -n "$pf" ] && [ -f "$pf" ] || fail "k4510-pas: $src: no such project file"
    val() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//Ip" "$pf" | tr -d '\r' | tail -1; }
    src=$(val MAIN); pout=$(val OUT)
    [ -n "$src" ] || fail "k4510-pas: $pf names no MAIN="
fi
case "$src" in *.pas|*.PAS|*.Pas) ;; *) src="$src.pas" ;; esac
# the machine's names are case-fixed on the way in, a shell's are not:
# take whichever spelling of the file exists
if [ ! -f "$src" ]; then
    f=$(find . -maxdepth 1 -iname "$src" | head -1)
    [ -n "$f" ] || fail "k4510-pas: $src: no such file"
    src=${f#./}
fi
base=${src%.*}
out=$(printf %s "$base" | tr A-Z a-z).prg
[ -n "$pout" ] && out=$pout

tmp=$(mktemp -d "${TMPDIR:-/tmp}/k4510-pas.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/src"
for f in $(find . -maxdepth 1 -iname '*.pas'); do
    ln -s "$PWD/${f#./}" "$tmp/src/$(basename "$f" | tr A-Z a-z)"
done
# the messages, one line each, to MAKE.ERR and -- readably -- to the screen
report() {
    "$K4510/tools/k4510-errfmt" < "$tmp/log" > "$tmp/err"
    [ -n "$ERR" ] && cat "$tmp/err" >> "$ERR"
    awk -F: '{ t = $0; sub(/^[^:]*:[^:]*:[^:]*:[^:]*:/, "", t)
               w = $4 == "E" ? "Error: " : $4 == "W" ? "Warning: " : ""
               print ($1 == "-" ? "" : toupper($1) ":" $2 ": ") w t }' "$tmp/err" >&2
}
main=$(printf %s "$src" | tr A-Z a-z)
( cd "$tmp/src" && "$MP_DIR/bin/mp" "$main" -target:k4510 -o:"$tmp/prog.a65" ) > "$tmp/log" 2>&1
st=$?
if [ $st -eq 0 ]; then
    "$MADS" "$tmp/prog.a65" -x -i:"$MP_DIR/base" -o:"$tmp/prog.prg" > "$tmp/mads.log" 2>&1
    st=$?
    [ $st -eq 0 ] || grep -i 'error' "$tmp/mads.log" >> "$tmp/log"
fi
report
if [ $st -ne 0 ]; then
    [ -s "$tmp/err" ] || fail "k4510-pas: the compiler failed and said nothing we understood" $st
    exit $st
fi
cp "$tmp/prog.prg" "$out" || exit 1
msg="$out: $(wc -c < "$out") bytes"
echo "$msg"
[ -n "$ERR" ] && echo "-:0:0:I:$msg" >> "$ERR"
exit 0
