10 REM SPLIT.BAS -- GRAPHICS ABOVE, FOUR LINES OF TEXT BELOW
20 REM SHEILA, VICKY'S DISPLAY LIST, TURNS THE TEXT LAYER OFF AT LINE 0
30 REM AND BACK ON AT LINE 448 -- 56 ROWS OF 8 -- EVERY FRAME, BY ITSELF.
40 REM ESCAPE STOPS IT; THEN TYPE GRAPHICS 0 TO PUT THE SCREEN BACK.
50 GRAPHICS 2:V=53248:L=PEEK(V+16)
60 FOR I=0 TO 23:READ B:POKE 48896+I,B:NEXT:POKE 48896+18,L
70 DATA 2,16,0,0,2,32,25,0,1,192,1,0,2,32,0,0,2,16,7,0,0,0,0,0
80 POKE V+96,0:POKE V+97,191:POKE V+98,0:POKE V+99,0:POKE V+100,1
90 DIM Q(15,3):X1=100:Y1=40:X2=500:Y2=400:A=7:B=3:E=-5:F=4:K=0:H=16
95 REM GRAPHICS 2 CLEARED THE SCREEN: THE CURSOR IS AT THE TOP, WHERE THE
96 REM TEXT IS HIDDEN.  SIXTY EMPTY LINES TAKE IT DOWN TO THE FOUR THAT SHOW.
97 FOR I=1 TO 60:PRINT:NEXT
100 PRINT "EHBASIC: A 640X448 BITMAP ABOVE, FOUR ROWS OF TEXT BELOW."
110 PRINT "SHEILA HOLDS THE SPLIT. ANY KEY LEAVES."
200 T=PEEK(54541)+256*PEEK(54542):N=0
210 X1=X1+A:IF X1<0 OR X1>639 THEN A=-A:X1=X1+2*A
220 Y1=Y1+B:IF Y1<0 OR Y1>447 THEN B=-B:Y1=Y1+2*B
230 X2=X2+E:IF X2<0 OR X2>639 THEN E=-E:X2=X2+2*E
240 Y2=Y2+F:IF Y2<0 OR Y2>447 THEN F=-F:Y2=Y2+2*F
250 LINE Q(K,0),Q(K,1),Q(K,2),Q(K,3),0
260 H=H+1:IF H>255 THEN H=16
270 LINE X1,Y1,X2,Y2,H
280 Q(K,0)=X1:Q(K,1)=Y1:Q(K,2)=X2:Q(K,3)=Y2:K=(K+1) AND 15:N=N+1
290 Z=PEEK(54541)+256*PEEK(54542)-T:IF Z<0 THEN Z=Z+65536
300 IF Z>=120 THEN PRINT "EHBASIC:";INT(N*60/Z);" LINES A SECOND":GOTO 200
310 IF PEEK(53505)<128 THEN 210
320 GET G$:POKE V+100,0:GRAPHICS 0:END
