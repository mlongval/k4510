+/* A point at an intensity: the 4014's special point plot character, 32..127,
+ * taken as 0..95 of full brightness (its real table is not linear, but the
+ * dithered pictures use only a few levels and read well like this). */
+void PlotPointZ(int x, int y, int z)
+{
+    int k,l,tm;
+    unsigned char *p;
+    int lev = z - 32; if (lev < 0) lev = 0; if (lev > 95) lev = 95;
+    lev = 24 + lev * 72 / 95;                 /* never invisible: 24..96 of 96 */
+
+    if (y >= REAL_HEIGHT || y < 0)
+        return;
+    x=x*1.5;
+    y=WINDOW_HEIGHT-y*1.5;
+    for (k=0; k<3; k++)
+        for (l=0; l<3; l++)
+            if (y+l < WINDOW_HEIGHT) {
+                p = pixels + (int)((y + l) * WINDOW_WIDTH + x + k) * 4;
+                p[0]=0xff;
+                tm = pxptn[k*3+l] * lev / 96 + (int)(p[1]>>2);
+                if (tm > 0xfc)
+                    tm=0xfc;
+                p[1]=tm;
+                p[2]=0xff;
+            }
+}
