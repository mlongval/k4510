+/* K4510: full screen, the page is placed where the emulator's Placement
+   setting puts its own picture (K4510_PLACEMENT=left|centre|right, exported
+   by the emulator for its host shell), scaled to fit, aspect kept.  Without
+   the variable the logical size below centres it, as before. */
+static SDL_Rect place_rect; static int placed;
+static SDL_Renderer *place_rend; static unsigned place_w, place_h;
+static void place_compute(void)
+{
+    const char *p = getenv("K4510_PLACEMENT"); int W = 0, H = 0; double sc;
+    placed = 0;
+    /* Placed when the emulator is full screen (KMSDRM stick, TEK40XX_FULLSCREEN)
+       OR when it hands us its window rectangle on a desktop (K4510_WINRECT):
+       either way the page fills the machine's own screen real estate. */
+    if (!p || (!getenv("TEK40XX_FULLSCREEN") && !getenv("K4510_WINRECT")) || !place_rend) return;
+    SDL_GetRendererOutputSize(place_rend, &W, &H);
+    if (W <= 0 || H <= 0) return;
+    sc = (double)W / place_w; if ((double)H / place_h < sc) sc = (double)H / place_h;
+    place_rect.w = (int)(place_w * sc); place_rect.h = (int)(place_h * sc);
+    place_rect.y = (H - place_rect.h) / 2;
+    place_rect.x = !strcmp(p, "left") ? 0 : !strcmp(p, "right") ? W - place_rect.w : (W - place_rect.w) / 2;
+    placed = 1;
+}
+static int place_mx(int x) { return placed && place_rect.w ? (int)((x - place_rect.x) * (long)place_w / place_rect.w) : x; }
+static int place_my(int y) { return placed && place_rect.h ? (int)((y - place_rect.y) * (long)place_h / place_rect.h) : y; }
 static unsigned int init_w = 0;
 static unsigned int init_h = 0;
 static int32 lcurr_x = 0;
