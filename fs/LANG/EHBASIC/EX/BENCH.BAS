10 REM K4510 BENCHMARKS MENU. EACH BENCHMARK CHAINS BACK HERE (PEEK(1039)=1).
20 POKE 1039,0: PRINT CHR$(12)
30 PRINT "K4510  BENCHMARKS  (TIMED BY THE 60 HZ FRAME COUNTER)": PRINT
40 PRINT "  1-8  RUGG/FELDMAN 1977 BENCHMARK 1..8   (C64: 1.2 S TO 47.5 S)"
50 PRINT "  A    AHL'S SIMPLE BENCHMARK 1983       (C64: 1:53)"
60 PRINT "  S    BYTE SIEVE 1981, FULL SIZE: FLAGS AS BYTES IN A BANKED WINDOW"
70 PRINT "  F    FLOAT: 5000 X SQR, SIN, *, /      (MATH UNIT)"
80 PRINT "  E    EXPRESSIONS: 20000 EVALUATIONS     (EXPRESSION COMPILER)"
90 PRINT "  D    DEMOS MENU"
100 PRINT "  Q    QUIT TO READY": PRINT
110 PRINT "CHOICE? ";
120 GET K$: IF K$="" THEN 120
130 PRINT K$: POKE 1039,1
140 IF K$>="1" AND K$<="8" THEN LOAD "RF"+K$+".BAS"
150 IF K$="A" OR K$="a" THEN LOAD "AHL.BAS"
160 IF K$="S" OR K$="s" THEN LOAD "SIEVE.BAS"
170 IF K$="F" OR K$="f" THEN LOAD "FLOAT.BAS"
180 IF K$="E" OR K$="e" THEN LOAD "EXPR.BAS"
190 IF K$="D" OR K$="d" THEN LOAD "DEMOS.BAS"
200 IF K$="Q" OR K$="q" THEN POKE 1039,0: END
210 GOTO 110
