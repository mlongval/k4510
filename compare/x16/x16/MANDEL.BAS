100 REM GORDON HENDERSON'S BASIC MANDELBROT BENCHMARK, AS PUBLISHED:
105 REM PROJECTS.DROGON.NET/RETRO-BASIC-BENCHMARKING-WITH-MANDELBROT
110 REM LINES 130-310 ARE HIS, UNTOUCHED; ONLY THE CLOCK (TI) IS OURS
115 PRINT "MANDELBROT - X16 BASIC (INTERPRETED) - FP + STRINGS"
120 PRINT "START":T0=TI
130 Z$=".,'~=+:;*%&$OXB#@ "
140 F=50
150 FOR Y=-12 TO 12
160 FOR X=-49 TO 29
170 C=X*229/100
180 D=Y*416/100
190 A=C:B=D:I=0
200 Q=B/F:S=B-(Q*F)
210 T=((A*A)-(B*B))/F+C
220 B=2*((A*Q)+(A*S/F))+D
230 A=T:P=A/F:Q=B/F
240 IF ((P*P)+(Q*Q))>=5 GOTO 280
250 I=I+1:IF I<16 GOTO 200
260 PRINT " ";
270 GOTO 290
280 PRINT MID$(Z$,I+1,1);
290 NEXT X
300 PRINT ""
310 NEXT Y
320 T=TI-T0
330 PRINT "FINISHED"
340 PRINT "RESULT MANDEL";T/60;"S"
350 PRINT "DONE"
