# DOOM on the K4510's Tube co-processor.  Built for the HOST the emulator
# runs on, like tube/bbcbasic beside it -- see ALTERED-K4510.md.
#
#   make -f Makefile.k4510        -> doomk4510
#
# The two flags that matter are on CFLAGS below: -DCMAP256 turns the engine's
# framebuffer into one byte a pixel (VICKY's bitmap is 8 bpp), and the RESX/
# RESY pair set it to DOOM's own 320x200 instead of doomgeneric's 640x400
# default.  Nothing in the vendored source is edited to achieve either.

CC      ?= gcc
CFLAGS  += -O2 -Wall -Wno-unused-variable -Wno-unused-but-set-variable \
           -DNORMALUNIX -DLINUX -D_DEFAULT_SOURCE \
           -DCMAP256 -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200 \
           -DDISABLE_SDL2MIXER -I. -Iopl     # i_oplmusic.c includes "opl.h", which lives in opl/
LDLIBS  += -lm -lpthread          # the OPL driver runs its callback queue on a thread

OBJDIR  = build
OUTPUT  = doomk4510

SRC = dummy.c am_map.c doomdef.c doomstat.c dstrings.c d_event.c d_items.c \
      d_iwad.c d_loop.c d_main.c d_mode.c d_net.c f_finale.c f_wipe.c \
      g_game.c hu_lib.c hu_stuff.c info.c i_cdmus.c i_endoom.c i_joystick.c \
      i_scale.c i_sound.c i_system.c i_timer.c memio.c m_argv.c m_bbox.c \
      m_cheat.c m_config.c m_controls.c m_fixed.c m_menu.c m_misc.c \
      m_random.c p_ceilng.c p_doors.c p_enemy.c p_floor.c p_inter.c \
      p_lights.c p_map.c p_maputl.c p_mobj.c p_plats.c p_pspr.c p_saveg.c \
      p_setup.c p_sight.c p_spec.c p_switch.c p_telept.c p_tick.c p_user.c \
      r_bsp.c r_data.c r_draw.c r_main.c r_plane.c r_segs.c r_sky.c \
      r_things.c sha1.c sounds.c statdump.c st_lib.c st_stuff.c s_sound.c \
      tables.c v_video.c wi_stuff.c w_checksum.c w_file.c w_main.c w_wad.c \
      z_zone.c w_file_stdc.c i_input.c i_video.c doomgeneric.c mus2mid.c \
      doomgeneric_k4510.c \
      midifile.c i_oplmusic.c opl/opl.c opl/opl_queue.c opl_k4510.c

OBJS = $(addprefix $(OBJDIR)/, $(SRC:.c=.o))

all: $(OUTPUT)

# [K4510] i_oplmusic.c and midifile.c are newer than the rest of this tree
# (chocolate-doom 895f581 against doomgeneric dcb7a8d) and use PACKED_STRUCT,
# I_Realloc and M_fopen, which the fork predates.  k4510_compat.h supplies
# exactly those three, force-included here so the vendored files stay
# byte-identical to upstream.
$(OBJDIR)/i_oplmusic.o: CFLAGS += -include k4510_compat.h
$(OBJDIR)/midifile.o:   CFLAGS += -include k4510_compat.h

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OUTPUT): $(OBJS)
	$(CC) $(OBJS) $(LDLIBS) -o $@

clean:
	rm -rf $(OBJDIR) $(OUTPUT)

.PHONY: all clean
