100 REM THE BYTE SIEVE (GILBREATH, 1981), FULL SIZE -- X16 BASIC
110 REM 8191 FLAGS IN AN INTEGER ARRAY (A FLOAT ARRAY THAT SIZE,
120 REM 40 KB, DOES NOT FIT IN BASIC'S 38 KB), ONE ITERATION
130 PRINT "BYTE SIEVE, 8191 FLAGS, X16 BASIC"
140 S=8190
150 DIM F%(S)
200 T=TI
210 C=0
220 FOR I=0 TO S:F%(I)=1:NEXT
230 FOR I=0 TO S
240 IF F%(I)=0 THEN 300
250 P=I+I+3
260 K=I+P
270 IF K>S THEN 290
280 F%(K)=0:K=K+P:GOTO 270
290 C=C+1
300 NEXT I
310 T=TI-T
320 PRINT C;"PRIMES"
330 PRINT "RESULT SIEVE";T/60;"S"
340 PRINT "DONE"
