10 REM SPACE INVADERS: TWO FRAMES DRAWN ONCE, TEN SPRITES MARCH, ANIMATE AND FLIP
20 MODE 2
30 FOR F%=0 TO 1
40 FOR R%=0 TO 7
50 READ A$
60 FOR C%=0 TO 10
70 IF MID$(A$,C%+1,1)="X" THEN GCOL 0,2:X=F%*200+C%*8:Y=(7-R%)*8.5334:MOVE X,Y:PLOT 101,X+7,Y+7.9
80 NEXT:NEXT
90 MOVE F%*200,0:VDU 23,27,1,F%,64,32|
100 NEXT
110 CLG
120 DX=12:X0=40:Y0=760:F%=0:T%=0
130 REPEAT
140 F%=1-F%:T%=T%+1
150 FOR I%=2 TO 11:VDU 23,27,5,I%,F%|:NEXT
160 X0=X0+DX
170 IF X0>340 OR X0<40 THEN DX=-DX:Y0=Y0-40:FOR I%=2 TO 11:VDU 23,27,3,I%,-(DX<0)|:NEXT
180 FOR I%=0 TO 4:VDU 23,27,0,I%+2|:PLOT &ED,X0+I%*176,Y0:VDU 23,27,0,I%+7|:PLOT &ED,X0+I%*176+88,Y0-90:NEXT
190 SOUND 0,-8,20+(T% MOD 4)*10,2
200 WAIT 25
210 IF Y0<200 THEN Y0=760
220 UNTIL FALSE
230 DATA "..X.....X..","...X...X...","..XXXXXXX..",".XX.XXX.XX.","XXXXXXXXXXX","X.XXXXXXX.X","X.X.....X.X","...XX.XX..."
240 DATA "..X.....X..","X..X...X..X","X.XXXXXXX.X","XXX.XXX.XXX","XXXXXXXXXXX",".XXXXXXXXX.","..X.....X..",".X.......X."
