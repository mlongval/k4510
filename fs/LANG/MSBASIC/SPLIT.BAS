10 REM SPLIT: GRAPHICS ABOVE, FOUR LINES OF TEXT BELOW (SHEILA)
20 REM MS BASIC HAS NO GRAPHICS WORDS: IT POKES VICKY'S BLITTER,
30 REM TEN POKES A LINE. CTRL-C STOPS IT; RUN 400 PUTS IT BACK.
35 REM (MS BASIC READS 72 CHARACTERS A LINE: KEEP THEM SHORT)
40 V=53248:L=PEEK(V+16)
42 REM WHERE THE PARTS MEET, FROM JIM: $DA06 ROWS, $DA08 THE TOP
43 REM BAND'S ROWS. 16 GLASS LINES A ROW, HALF THAT IN BITMAP ROWS
44 TB=PEEK(55816)*16:S=(PEEK(55816)+PEEK(55814)-4)*16
45 YL=TB/2:YH=S/2:YM=YH-1
50 FOR I=0 TO 35:READ B:POKE 39168+I,B:NEXT
52 POKE 39174,L:POKE 39198,L
54 POKE 39177,TB AND 255:POKE 39178,INT(TB/256)
56 POKE 39189,S AND 255:POKE 39190,INT(S/256)
60 DATA 2,32,0,0,2,16,7,0,1,0,0,0,2,16,0,0,2,32,25,0
65 DATA 1,0,0,0,2,32,0,0,2,16,7,0,0,0,0,0
70 FOR I=33 TO 37:POKE V+I,0:NEXT:POKE V+38,128:POKE V+39,2
80 POKE V+40,0:POKE V+41,0:POKE V+42,32:POKE V+43,0
90 D=53760:FOR I=0 TO 7:POKE D+I,0:NEXT:POKE D+6,32
95 C=640*YH:C2=INT(C/65536):C1=INT((C-C2*65536)/256)
100 POKE D+8,C-INT(C/256)*256:POKE D+9,C1:POKE D+10,C2
105 POKE D+11,0:POKE D+12,2
110 POKE V+116,0:POKE V+117,0:POKE V+118,32:POKE V+119,0
120 POKE V+120,128:POKE V+121,2:POKE V+122,YH AND 255
125 POKE V+123,INT(YH/256)
130 POKE V+126,128:POKE V+127,2:POKE V+128,6
140 POKE V+96,0:POKE V+97,153:POKE V+98,0:POKE V+99,0:POKE V+100,1
150 DIM Q(15,3):X1=100:Y1=YL+20:X2=500:Y2=YM-20
155 A=7:B=3:E=-5:F=4:K=0:H=16
160 PRINT:PRINT "MS BASIC: A BITMAP ABOVE, FOUR ROWS OF TEXT BELOW."
170 PRINT "SHEILA HOLDS THE SPLIT. ANY KEY LEAVES."
200 T=PEEK(54541)+256*PEEK(54542):N=0
210 X1=X1+A:IF X1<0 OR X1>639 THEN A=-A:X1=X1+2*A
220 Y1=Y1+B:IF Y1<YL OR Y1>YM THEN B=-B:Y1=Y1+2*B
230 X2=X2+E:IF X2<0 OR X2>639 THEN E=-E:X2=X2+2*E
240 Y2=Y2+F:IF Y2<YL OR Y2>YM THEN F=-F:Y2=Y2+2*F
250 P=0:U=Q(K,0):W=Q(K,1):R=Q(K,2):S=Q(K,3):GOSUB 500
260 H=H+1:IF H>255 THEN H=16
270 P=H:U=X1:W=Y1:R=X2:S=Y2:GOSUB 500
280 Q(K,0)=X1:Q(K,1)=Y1:Q(K,2)=X2:Q(K,3)=Y2
285 K=(K+1) AND 15:N=N+1
290 Z=PEEK(54541)+256*PEEK(54542)-T:IF Z<0 THEN Z=Z+65536
300 IF Z<120 THEN 310
305 PRINT "MS BASIC:";INT(N*60/Z);"LINES A SECOND":GOTO 200
310 IF PEEK(53505)<128 THEN 210
320 GET G$
400 POKE V+100,0:POKE V+32,0:POKE V+16,L:END
500 POKE V+112,P:POKE V+132,U AND 255:POKE V+133,INT(U/256)
510 POKE V+134,W AND 255:POKE V+135,INT(W/256)
520 POKE V+136,R AND 255:POKE V+137,INT(R/256)
530 POKE V+138,S AND 255:POKE V+139,INT(S/256):POKE V+130,1:RETURN
