diff --git a/src/tests/emulation-cursor-shape.test b/src/tests/emulation-cursor-shape.test
new file mode 100755
index 0000000..d572697
--- /dev/null
+++ b/src/tests/emulation-cursor-shape.test
@@ -0,0 +1,70 @@
+#!/bin/sh
+
+#
+# This test exercises the cursor shape ascii sequence in Mosh.
+#
+
+# shellcheck source=e2e-test-subrs
+. "$(dirname "$0")/e2e-test-subrs"
+PATH=$PATH:.:$srcdir
+# Top-level wrapper.
+if [ $# -eq 0 ]; then
+    e2e-test "$0" baseline direct verify post
+    exit
+fi
+
+# OK, we have arguments, we're one of the test hooks.
+if [ $# -ne 1 ]; then
+    fail "bad arguments %s\n" "$@"
+fi
+
+baseline()
+{
+    # Clear (like the other emulation tests; without it the mosh and
+    # direct captures differ by a leading blank line)
+    printf '\033[H\033[J'
+    while read -r shape sleep_time text; do
+        printf '\n\033[%d q%s' "$shape" "$text"
+        sleep $sleep_time
+    done <<EOF
+0 2 BlinkBlock0
+1 2 BlinkBlock1
+2 2 SteadyBlock
+3 2 BlinkUnderline
+4 2 SteadyUnderline
+5 2 BlinkBar
+6 2 SteadyBar
+6 0 done
+EOF
+    echo
+}
+
+# The captures only prove the display is not corrupted.  Also check
+# that mosh-client really sent each shape to the outer terminal (tmux
+# logs the client's output), and that it put the default cursor back
+# (ESC [ 0 SP q, ahead of its usual reset sequence) when exiting with
+# the shape still set to 6.
+post()
+{
+    log="$(basename "$0").d/baseline.tmux.log"
+    for n in 1 2 3 4 5 6; do
+        if ! grep -q -F "\\033[$n q" "$log"; then
+            printf "mosh-client never sent cursor shape %s\n" "$n" >&2
+            exit 1
+        fi
+    done
+    if ! grep -q -F '\033[0 q\033[?1l' "$log"; then
+        printf "mosh-client did not restore the cursor shape on exit\n" >&2
+        exit 1
+    fi
+    exit 0
+}
+
+case $1 in
+    baseline|direct)
+        baseline;;
+    post)
+        post;;
+    *)
+        fail "unknown test argument %s\n" "$1";;
+esac
