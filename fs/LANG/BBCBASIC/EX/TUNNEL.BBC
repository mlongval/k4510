10 REM A TUNNEL THAT NEVER REDRAWS: FIFTEEN CIRCLES AND A CYCLING PALETTE
20 MODE 2
30 FOR I%=15 TO 1 STEP -1
40 GCOL 0,I%:CIRCLE FILL 640,512,I%*34
50 NEXT
60 K%=0
70 REPEAT
80 K%=K%+1
90 FOR I%=1 TO 15
100 H=((I%+K%) MOD 15)/15
110 VDU 19,I%,16,255*FNw(H),255*FNw(H+1/3),255*FNw(H+2/3)|
120 NEXT
130 WAIT 3
140 UNTIL FALSE
150 DEF FNw(H):H=H-INT(H):IF H<1/3 THEN =1-3*H ELSE IF H<2/3 THEN =0 ELSE =3*H-2
