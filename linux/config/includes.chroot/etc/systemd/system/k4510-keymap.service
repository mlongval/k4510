# The keyboard layout chosen in the boot menu (k4510.kbd=<code>), applied before
# the console's own keyboard setup and the emulator's tty1 login.
#
# After=systemd-remount-fs, not systemd-tmpfiles-setup: tmpfiles-setup waits
# for local-fs.target, and keyboard-setup (which this runs before) comes
# before local-fs-pre.target -- an ordering cycle that systemd broke on every
# boot by dropping local-fs-pre.target (the Dell's journal, 2026-09-12).
# Nothing here needs tmpfiles: /etc is the live overlay, writable from the
# start, and setupcon needs no more than keyboard-setup itself does.
[Unit]
Description=K4510 keyboard layout from the boot menu (k4510.kbd=)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=console-setup.service keyboard-setup.service getty@tty1.service
ConditionKernelCommandLine=k4510.kbd

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/k4510-keymap
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
