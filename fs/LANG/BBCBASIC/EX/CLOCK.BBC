10 REM AN ANALOGUE CLOCK, ON THE MACHINE CLOCK
20 MODE 1
30 REPEAT
40 T$=TIME$
50 H=VAL(MID$(T$,17,2)):M=VAL(MID$(T$,20,2)):S=VAL(MID$(T$,23,2))
60 CLG
70 GCOL 0,3:CIRCLE 640,512,400
80 FOR I%=0 TO 11
90 A=RAD(I%*30):MOVE 640+370*SIN(A),512+370*COS(A):DRAW 640+395*SIN(A),512+395*COS(A)
100 NEXT
110 GCOL 0,1:A=RAD((H MOD 12)*30+M/2):MOVE 640,512:DRAW 640+220*SIN(A),512+220*COS(A)
120 GCOL 0,2:A=RAD(M*6+S/10):MOVE 640,512:DRAW 640+320*SIN(A),512+320*COS(A)
130 GCOL 0,3:A=RAD(S*6):MOVE 640,512:DRAW 640+360*SIN(A),512+360*COS(A)
140 PRINT TAB(28,29);T$;
150 WAIT 100
160 UNTIL FALSE
