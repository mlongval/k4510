#!/bin/sh
# k4510-cc NAME[.c]              compile a C program into NAME.prg beside it
# k4510-cc -p PROJECT.K4P        build a project: its sources, into one .prg
#
# The on-machine half of "self-hosted C": at the machine's prompt
#   CC SIEVE           (a K/OS word: it runs `!k4510-cc SIEVE`)
# compiles SIEVE.C in the current directory with cc65 and leaves SIEVE.prg
# beside it.  NAME may be a path, and a machine path (/LANG/C/SIEVE) is
# found under K4510_ROOT, the machine's fs/ -- which is how VI's :make and
# PROG compile the file they have open wherever you are standing.  The same
# recipe as the Makefile's fs/SYSTEM/BIN/%.prg rule: cc65 -O for the 65C02,
# ca65, ld65 with demo/prg.cfg (a .prg loaded at $6000, its own zero page
# and C stack) and the two startup objects demo/prg0.o and demo/romcalls.o.
# #include "k4510.h" and "far.h" resolve to demo/.
#
# A project (PROG's stage 3, Doc 2026-09-14: "not limited to just one file
# at a time") is a PROJECT.K4P beside its sources, KEY=value lines:
#     NAME=GAME          the program: game.prg unless OUT says otherwise
#     LANG=C
#     SRC=MAIN.C UTIL.C  the sources, linked together (MAIN= alone will do)
#     OUT=game.prg
#     # a comment
# Each source is compiled to an object kept on this side, in
# ~/.cache/k4510-cc/<the directory>, and compiled again only when it, a .H
# beside it, or k4510.h is newer than its object -- so a big program that
# changed in one file costs one file.
#
# The messages go to the screen, and -- one line each, in the form
# tools/k4510-errfmt describes -- to /SYSTEM/LOG/MAKE.ERR, which VI and PROG
# read.  K4510 names the checkout (default: the one this script lives in);
# cc65 must be on PATH.  Exit status is the compiler's.
set -u
K4510=${K4510:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
usage() { echo "usage: k4510-cc NAME[.c]   or   k4510-cc -p PROJECT.K4P" >&2; exit 2; }
[ $# -ge 1 ] || usage
ERR=
[ -n "${K4510_ROOT:-}" ] && [ -d "$K4510_ROOT/SYSTEM/LOG" ] && ERR=$K4510_ROOT/SYSTEM/LOG/MAKE.ERR
[ -n "$ERR" ] && : > "$ERR"
fail() { echo "$1" >&2; [ -n "$ERR" ] && echo "-:0:0:E:$1" >> "$ERR"; exit "${2:-1}"; }
command -v cc65 >/dev/null 2>&1 || fail "k4510-cc: no cc65 on PATH" 2
for f in demo/prg.cfg demo/k4510.h demo/prg0.s demo/romcalls.s; do
    [ -f "$K4510/$f" ] || fail "k4510-cc: $K4510/$f missing (K4510 must name the checkout)" 2
done

proj=
if [ "$1" = "-p" ]; then [ $# -ge 2 ] || usage; proj=$2; set -- "$2"; fi
arg=$1
case "$arg" in /*) [ -n "${K4510_ROOT:-}" ] && arg=$K4510_ROOT$arg ;; esac
cd "$(dirname "$arg")" 2>/dev/null || fail "k4510-cc: $(dirname "$1"): no such directory"
arg=$(basename "$arg")
here() {   # the file in this directory called $1, whatever its case
    if [ -f "$1" ]; then printf %s "$1"; return; fi
    f=$(find . -maxdepth 1 -iname "$1" | head -1); [ -n "$f" ] && printf %s "${f#./}"
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/k4510-cc.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
: > "$tmp/log"
report() {   # the messages, one line each, to MAKE.ERR and -- readably -- to the screen
    "$K4510/tools/k4510-errfmt" < "$tmp/log" > "$tmp/err"
    [ -n "$ERR" ] && cat "$tmp/err" >> "$ERR"
    awk -F: '{ t = $0; sub(/^[^:]*:[^:]*:[^:]*:[^:]*:/, "", t)
               w = $4 == "E" ? "Error: " : $4 == "W" ? "Warning: " : ""
               print ($1 == "-" ? "" : $1 ":" $2 ": ") w t }' "$tmp/err" >&2
}
# the two startup objects: the checkout's if make has built them, else here
for o in prg0 romcalls; do
    if [ -f "$K4510/demo/$o.o" ]; then cp "$K4510/demo/$o.o" "$tmp/$o.o"
    else ca65 --cpu 65c02 -o "$tmp/$o.o" "$K4510/demo/$o.s" || exit 1; fi
done
compile() {   # $1 the source, $2 the object: 0 if it compiled
    # k4510.h defines its helpers static, so every program that skips one gets a
    # "defined but never used" warning; those are the header's, not the user's
    # this unit's messages on their own first: an error in one file must not
    # fail the files after it
    rm -f "$tmp/unit.s"
    cc65 -O -t none --cpu 65c02 -I "$K4510/demo" -I . -o "$tmp/unit.s" "$1" 2>&1 | grep -v "is defined but never used" > "$tmp/unit.log"
    cat "$tmp/unit.log" >> "$tmp/log"
    [ -s "$tmp/unit.s" ] || return 1
    grep -q ': Error: ' "$tmp/unit.log" && return 1
    ca65 --cpu 65c02 -o "$2" "$tmp/unit.s" >> "$tmp/log" 2>&1 || return 1
    return 0
}

st=0; objs=; made=0; kept=0
if [ -z "$proj" ]; then                                  # one file, as it always was
    src=$arg
    case "$src" in *.c|*.C) ;; *) src="$src.c" ;; esac
    s=$(here "$src"); [ -n "$s" ] || fail "k4510-cc: $src: no such file"
    out=$(printf %s "${s%.*}" | tr A-Z a-z).prg
    compile "$s" "$tmp/prog.o" || st=1
    objs="$tmp/prog.o"
else                                                     # a project
    p=$(here "$arg"); [ -n "$p" ] || fail "k4510-cc: $arg: no such project file"
    val() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//Ip" "$p" | tr -d '\r' | tail -1; }
    name=$(val NAME); srcs=$(val SRC); out=$(val OUT)
    [ -n "$srcs" ] || srcs=$(val MAIN)
    [ -n "$name" ] || name=$(basename "$PWD")
    [ -n "$out" ] || out=$(printf %s "$name" | tr A-Z a-z).prg
    [ -n "$srcs" ] || fail "k4510-cc: $p names no sources (SRC= or MAIN=)"
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/k4510-cc/$(printf %s "$PWD" | md5sum | cut -c1-12)
    mkdir -p "$cache" || fail "k4510-cc: no cache directory $cache"
    newest_h=$(find . -maxdepth 1 -iname '*.h' -newer "$K4510/demo/k4510.h" 2>/dev/null | head -1)
    for w in $srcs; do
        s=$(here "$w"); [ -n "$s" ] || { echo "$w(0): Error: no such source file" >> "$tmp/log"; st=1; continue; }
        o=$cache/$(printf %s "${s%.*}" | tr A-Z a-z).o
        again=0
        [ -f "$o" ] || again=1
        [ "$again" = 0 ] && [ "$s" -nt "$o" ] && again=1
        [ "$again" = 0 ] && [ "$K4510/demo/k4510.h" -nt "$o" ] && again=1
        [ "$again" = 0 ] && [ -n "$(find . -maxdepth 1 -iname '*.h' -newer "$o" | head -1)" ] && again=1
        if [ "$again" = 1 ]; then
            if compile "$s" "$o.new"; then mv "$o.new" "$o"; made=$((made + 1)); else rm -f "$o.new"; st=1; fi
        else kept=$((kept + 1)); fi
        objs="$objs $o"
    done
fi
if [ $st -eq 0 ]; then
    ld65 -C "$K4510/demo/prg.cfg" -o "$tmp/prog.prg" "$tmp/prg0.o" "$tmp/romcalls.o" $objs none.lib >> "$tmp/log" 2>&1 || st=$?
fi
report
[ $st -eq 0 ] || exit $st
cp "$tmp/prog.prg" "$out" || exit 1
msg="$out: $(wc -c < "$out") bytes"
[ -n "$proj" ] && msg="$msg ($made compiled, $kept kept)"
echo "$msg"
[ -n "$ERR" ] && echo "-:0:0:I:$msg" >> "$ERR"
exit 0
