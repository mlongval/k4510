1 REM FLOAT BENCHMARK: THIS MACHINE'S OWN, NO HISTORICAL PEER
4 PRINT CHR$(12);"FLOAT: 5000 ROUNDS OF A=A+SQR(I)*1.5/3+SIN(I/100)"
5 PRINT "EHBASIC'S FLOAT ARITHMETIC, SQR AND SIN RUN ON THE MATH UNIT."
6 PRINT
20 T=PEEK(54541)+256*PEEK(54542)
30 A=0
40 FOR I=1 TO 5000
50 A=A+SQR(I)*1.5/3+SIN(I/100)
60 NEXT
70 T=PEEK(54541)+256*PEEK(54542)-T: IF T<0 THEN T=T+65536
80 SC=INT(T/0.6+0.5)/100
90 PRINT "A ="; A
100 PRINT "THIS MACHINE: ";MID$(STR$(SC),2);" SECONDS"
110 PRINT
120 PRINT "FOR SCALE, THIS SAME PROGRAM ON THIS SAME MACHINE:"
130 PRINT "  BEFORE THE MATH UNIT (SOFTWARE FLOATS)   4.03 S"
140 PRINT "  MATH UNIT, INTERPRETED EXPRESSIONS       1.66 S"
150 PRINT: PRINT "METRIC: TOTAL RUN TIME, SELF-TIMED. SEE ALSO EXPR.BAS."
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
