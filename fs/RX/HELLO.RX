/* HELLO.RX -- the shape of a script.  Run it with:  RX HELLO  or  HELLO */
parse arg who
if who = '' then who = 'world'
say 'hello,' who
say 'it is' time() 'on' date()
do i = 1 to 3
  say '  line' i 'of' 3
end
'DIR /RX'                                  /* an unknown clause is a command */
if rc = 0 then say 'the shell was happy'
exit 0
