#!/bin/sh
# k4510-grub-personalities -- add the personalities to the host's GRUB menu.
#
# Doc, 2026-10-08: "If I hold down [a key] on boot, it shows me a list of
# Personalities, something like FPGA images.  K4510 is the main version;
# C-128/C64/PET would be an option, Amiga could also become one."
#
# The key is the one the Dell already has: right Shift brings up GRUB, and
# GRUB is the list.  Each personality is the same K4510 Linux booted with
# k4510.personality=NAME on its command line; profile.d/k4510.sh sees it and
# runs k4510-personality NAME before the K4510 (quitting it lands in the
# K4510).  An entry is shown only while its image is on the K4510 partition
# (personalities/<family>.squashfs, ~/Projects/BMC64Port deploys them), and
# none of them savedefault: the next boot is whatever was last saved, so the
# K4510 stays the main machine.
#
# Writes $GRUB_D/43_k4510_personalities, reading the search label and the
# command line from the 42_k4510 that install-k4510.sh wrote beside it, so
# both always boot the same system.  install-k4510.sh runs this; on a machine
# installed before it existed, run it once from the host OS and regenerate:
#
#   sudo ./k4510-grub-personalities && sudo grub2-mkconfig -o /boot/grub2/grub.cfg
set -e
GRUB_D=${GRUB_D:-/etc/grub.d}
DST_LABEL=${DST_LABEL:-K4510}
SRC="$GRUB_D/42_k4510"
[ -f "$SRC" ] || { echo "no $SRC: install the K4510 first (install-k4510.sh)" >&2; exit 1; }
# the first entry's search label, and its command line without the display words
LIVE_SEARCH=$(sed -n 's/.*search --no-floppy --set=root --label \([^ ]*\).*/\1/p' "$SRC" | head -n1)
CMDLINE=$(sed -n 's|.*linux  */live/vmlinuz \(.*\) quiet splash.*|\1|p' "$SRC" | head -n1)
[ -n "$LIVE_SEARCH" ] && [ -n "$CMDLINE" ] || { echo "cannot read the label/command line from $SRC" >&2; exit 1; }

entry() {   # name title
    printf '    menuentry "K4510 > %s" --class k4510 {\n' "$2"
    printf '        clear\n        insmod part_gpt\n        insmod ext2\n'
    printf '        search --no-floppy --set=root --label %s\n' "$LIVE_SEARCH"
    printf '        linux  /live/vmlinuz %s quiet splash loglevel=3 vt.global_cursor_default=0 k4510.personality=%s\n' "$CMDLINE" "$1"
    printf '        initrd /live/initrd.img\n    }\n'
}
OUT="$GRUB_D/43_k4510_personalities"
{
    echo '#!/bin/sh'
    echo '# Written by k4510-grub-personalities (the K4510 repo, linux/): the'
    echo "# K4510's other machines.  Each family's entries appear only while its"
    echo "# image is on the $DST_LABEL partition.  Re-run that script; do not edit this."
    echo "cat <<'MENU'"
    echo 'insmod part_gpt'
    echo 'insmod ext2'
    echo "search --no-floppy --set=k4510save --label $DST_LABEL"
    echo 'if [ -f ($k4510save)/personalities/vice.squashfs ]; then'
    entry c64 "Commodore 64"; entry c128 "Commodore 128"; entry pet "Commodore PET"
    echo 'fi'
    echo 'if [ -f ($k4510save)/personalities/amiga.squashfs ]; then'
    entry a500 "Amiga 500"; entry a1200 "Amiga 1200"
    echo 'fi'
    echo 'MENU'
} > "$OUT"
chmod +x "$OUT"
echo "wrote $OUT (boots from label $LIVE_SEARCH)"
