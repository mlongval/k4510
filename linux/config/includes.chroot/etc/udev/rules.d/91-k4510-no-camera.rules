# The K4510x has no use for a camera (Doc, 2026-10-06: "for now the webcam is a
# moot point. turn it off completely. may come back much later").  Any USB
# device with a video-class interface (class 0e: the Dell's
# Integrated_Webcam_HD, or one plugged in) is de-authorized as it appears:
# the kernel lets go of it, no driver binds, and the port may power down.
# To have it back: delete this file and /etc/modprobe.d/k4510-no-camera.conf
# (from includes.chroot, so the next layer carries it), or for one session
#   echo 1 | sudo tee /sys/bus/usb/devices/<port>/authorized
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="0e", RUN+="/bin/sh -c 'echo 0 > /sys%p/../authorized'"
