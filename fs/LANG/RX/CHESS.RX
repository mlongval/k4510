/* CHESS.RX -- play a game of chess without a chess program on the screen.
 *
 * Every command here is a swap: the script writes /LANG/RX/MAIL.CMD, K/OS loads
 * CHESS over this interpreter, chess does the work and writes its answer,
 * and the interpreter comes back.  The position lives in /APPS/CHESS/PORT.GAM
 * between calls, which is what makes a game possible at all.
 */
nl = d2c(10)                                 /* the board comes back as eight lines */
address chess
'NEW'
say 'A new game.  You are White.  Moves are typed as e2e4; Q gives up.'
say
do forever
  call board
  say '  your move?'
  pull m
  if m = 'Q' | m = 'QUIT' then leave
  if length(m) < 4 then do
    say '  moves look like e2e4 (or e7e8q to promote)'
    iterate
  end
  'MOVE' m
  if rc \= 0 then do
    say '  ' result
    iterate
  end
  say '  you play' word(result, 2)
  'STATUS'
  if pos('to move', result) = 0 then leave
  say '  thinking...'
  'GO'
  if rc \= 0 then leave
  say '  the engine plays' word(result, 3)
  'STATUS'
  if pos('to move', result) = 0 then leave
end
call board
'STATUS'
say result
'FEN'
say 'the position was' result
exit 0

/* the eight lines chess sends back, with the files and ranks written in */
board:
  'BOARD'
  b = result
  say '      a b c d e f g h'
  do r = 8 to 1 by -1
    parse var b line (nl) b
    out = ''
    do c = 1 to 8
      out = out substr(line, c, 1)
    end
    say '  ' r out ' ' r                      /* the blank operator puts ONE space between operands */
  end
  say '      a b c d e f g h'
  return
