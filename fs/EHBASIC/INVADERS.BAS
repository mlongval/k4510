1 REM SPACE INVADERS FOR THE K4510, IN EHBASIC.
2 REM THE TEXT SCREEN (80X30X4 = 9600 BYTES AT $030000) IS BANKED INTO
3 REM $2000-$5FFF BY BANK REGISTERS 1 AND 2: A CELL IS POKE 8192+(Y*80+X)*4.
4 REM KEYS: A/D OR CURSOR KEYS MOVE, SPACE FIRES, Q QUITS.
10 POKE 54788,0: POKE 54789,0: POKE 54790,3: POKE 54791,0: REM BANK 1 -> $030000
11 POKE 54792,0: POKE 54793,32: POKE 54794,3: POKE 54795,0: REM BANK 2 -> $032000 (THE SCREEN IS 9600 BYTES: TWO 8 KB BLOCKS)
20 S=54752: POKE S,128: REM THE SOUND SEQUENCER AT $D5E0: CH, AMP, PITCH, DUR (DUR QUEUES THE NOTE)
30 REM CHANNEL 0 IS NOISE (THE SHOT), 1 AND 2 ARE TONES (HIT, EXPLOSION); +16 FLUSHES THE CHANNEL FIRST
40 SC=0: LI=3: WV=1: DIM A(24)
50 PRINT CHR$(12);
60 REM ---- NEW WAVE ----
70 GOSUB 9000: REM CLEAR FIELD
80 NA=24: FOR I=1 TO 24: A(I)=1: NEXT
90 GX=8: GY=3: DI=1: MM=12-WV*2: IF MM<3 THEN MM=3
100 MC=MM: PX=39: BY=0: OY=0: EY=0
110 GOSUB 8000: GOSUB 8500: GOSUB 8700
120 REM ---- MAIN LOOP, ONCE PER FRAME ----
130 TF=PEEK(54541)
140 IF PEEK(54541)=TF THEN 140
150 GET K$
160 IF K$="Q" OR K$="q" THEN 700
170 IF (K$="A" OR K$="a" OR K$=CHR$(130)) AND PX>1 THEN GOSUB 8600: PX=PX-1: GOSUB 8500
180 IF (K$="D" OR K$="d" OR K$=CHR$(131)) AND PX<77 THEN GOSUB 8600: PX=PX+1: GOSUB 8500
190 IF K$=" " AND BY=0 THEN BY=25: BX=PX+1: POKE S,16: POKE S+1,241: POKE S+2,120: POKE S+3,2: REM FIRE
200 IF BY THEN GOSUB 8100
210 IF EY THEN GOSUB 8300
220 IF EY=0 AND RND(0)<0.02+WV*0.005 THEN GOSUB 8200
230 MC=MC-1: IF MC=0 THEN MC=MM: GOSUB 8400
240 REM
250 IF NA=0 THEN WV=WV+1: PRINT CHR$(12);"WAVE CLEARED!": FOR I=1 TO 60: GOSUB 9100: NEXT: GOTO 60
260 GOTO 130
300 REM ---- PLAYER HIT ----
310 LI=LI-1: EY=0: POKE S,17: POKE S+1,241: POKE S+2,20: POKE S+3,30: GOSUB 8700
320 FOR I=1 TO 30: GOSUB 9100: NEXT
330 IF LI=0 THEN 700
340 GOTO 130
700 REM ---- GAME OVER ----
710 POKE 8192+(14*80+34)*4,71: POKE 8192+(14*80+35)*4,65: POKE 8192+(14*80+36)*4,77: POKE 8192+(14*80+37)*4,69
720 POKE 8192+(14*80+39)*4,79: POKE 8192+(14*80+40)*4,86: POKE 8192+(14*80+41)*4,69: POKE 8192+(14*80+42)*4,82
730 FOR I=34 TO 42: POKE 8192+(14*80+I)*4+2,2: NEXT
740 FOR I=1 TO 180: GOSUB 9100: NEXT
750 POKE 54791,255: POKE 54795,255: POKE S,128: PRINT CHR$(12);"SCORE";SC
760 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
770 END
8000 REM ---- DRAW ALL INVADERS ----
8010 FOR R=0 TO 2: FOR C=0 TO 7: I=R*8+C+1
8020 X=GX+C*5: Y=GY+R*2: P=8192+(Y*80+X)*4
8030 IF A(I) THEN POKE P,87: POKE P+1,0: POKE P+2,13-R*3: GOTO 8050
8040 POKE P,32
8050 NEXT: NEXT: RETURN
8100 REM ---- BULLET UP ----
8110 P=8192+(BY*80+BX)*4: POKE P,32
8120 BY=BY-1: IF BY=2 THEN BY=0: RETURN
8130 P=8192+(BY*80+BX)*4: CH=PEEK(P)
8140 IF CH=87 THEN GOSUB 8800: RETURN
8150 POKE P,33: POKE P+2,1: RETURN
8200 REM ---- AN INVADER DROPS A BOMB ----
8210 I=INT(RND(0)*24)+1: IF A(I)=0 THEN RETURN
8220 R=INT((I-1)/8): C=(I-1)-R*8: EX=GX+C*5: EY=GY+R*2+1
8230 RETURN
8300 REM ---- BOMB DOWN ----
8310 P=8192+(EY*80+EX)*4: IF PEEK(P)=42 THEN POKE P,32
8320 EY=EY+1: IF EY>27 THEN EY=0: RETURN
8330 IF EY=27 AND EX>=PX AND EX<=PX+2 THEN 300
8340 P=8192+(EY*80+EX)*4: POKE P,42: POKE P+2,10: RETURN
8400 REM ---- MARCH ----
8410 GOSUB 8900: REM ERASE ROW CELLS CHEAPLY: REDRAW HANDLES IT
8420 GX=GX+DI
8430 IF GX<1 OR GX>39 THEN DI=-DI: GX=GX+DI: GY=GY+1: MM=MM-1: IF MM<2 THEN MM=2
8440 IF GY+4>=27 THEN LI=0: GOTO 700: REM THEY LANDED: GAME OVER
8450 GOSUB 8000: RETURN
8500 REM ---- DRAW PLAYER ----
8510 P=8192+(27*80+PX)*4: POKE P,47: POKE P+1,0: POKE P+2,1
8520 POKE P+4,94: POKE P+5,0: POKE P+6,1: POKE P+8,92: POKE P+9,0: POKE P+10,1
8530 RETURN
8600 REM ---- ERASE PLAYER ----
8610 P=8192+(27*80+PX)*4: POKE P,32: POKE P+4,32: POKE P+8,32: RETURN
8700 REM ---- STATUS ----
8710 P=8192+(1*80+2)*4: POKE P,83: POKE P+4,67: POKE P+8,58: REM "SC:"
8720 V=SC: FOR I=5 TO 1 STEP -1: D=V-INT(V/10)*10: POKE 8192+(1*80+3+I)*4,48+D: V=INT(V/10): NEXT
8730 P=8192+(1*80+70)*4: FOR I=0 TO 2: POKE P+I*4,32: NEXT
8740 FOR I=1 TO LI: POKE 8192+(1*80+69+I)*4,94: POKE 8192+(1*80+69+I)*4+2,1: NEXT
8750 RETURN
8800 REM ---- BULLET HIT AN INVADER: WHICH? ----
8810 C=INT((BX-GX)/5): R=INT((BY-GY)/2): I=R*8+C+1
8820 IF I<1 OR I>24 THEN BY=0: RETURN
8830 IF A(I)=0 THEN BY=0: RETURN
8840 A(I)=0: NA=NA-1: SC=SC+(3-R)*10+WV*5: POKE P,32
8850 POKE S,18: POKE S+1,241: POKE S+2,60: POKE S+3,4: BY=0: GOSUB 8700: RETURN
8900 REM ---- ERASE THE GRID (BEFORE A MARCH) ----
8910 FOR R=0 TO 2: FOR C=0 TO 7
8920 POKE 8192+((GY+R*2)*80+GX+C*5)*4,32
8930 NEXT: NEXT: RETURN
9000 REM ---- CLEAR THE PLAYFIELD ----
9010 FOR Y=2 TO 28: FOR X=0 TO 79: POKE 8192+(Y*80+X)*4,32: NEXT: NEXT: RETURN
9100 REM ---- WAIT ONE FRAME ----
9110 TF=PEEK(54541)
9120 IF PEEK(54541)=TF THEN 9120
9130 RETURN
