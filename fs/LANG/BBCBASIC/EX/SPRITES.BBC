10 REM 64 HARDWARE SPRITES: EIGHT BALLS DRAWN ONCE, THEN VICKY MOVES THEM
20 MODE 2
30 VDU 19,8,16,255,128,0|
40 FOR C%=1 TO 8
50 X%=C%*100:Y%=100
60 GCOL 0,C%:CIRCLE FILL X%,Y%,30
70 GCOL 0,7:CIRCLE FILL X%-10,Y%+12,7
80 MOVE X%-32,Y%-34:VDU 23,27,1,C%-1,32,32|
90 NEXT
100 FOR I%=8 TO 63:VDU 23,27,5,I%,I% MOD 8|:NEXT
110 CLG
120 DIM X(63),Y(63),U(63),V(63)
130 FOR I%=0 TO 63:X(I%)=RND(1200):Y(I%)=RND(900):U(I%)=RND(14)-7:V(I%)=RND(14)-7:NEXT
140 REPEAT
150 FOR I%=0 TO 63
160 X(I%)=X(I%)+U(I%):Y(I%)=Y(I%)+V(I%)
170 IF X(I%)<0 OR X(I%)>1215 THEN U(I%)=-U(I%)
180 IF Y(I%)<0 OR Y(I%)>955 THEN V(I%)=-V(I%)
190 VDU 23,27,0,I%|:PLOT &ED,X(I%),Y(I%)
200 NEXT
210 WAIT 1
220 UNTIL FALSE
