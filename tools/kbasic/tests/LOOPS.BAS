PRINT "A:"; : FOR i = 1 TO 5: PRINT i; : NEXT: PRINT
PRINT "G:"; i
PRINT "B:"; : FOR i = 10 TO 1 STEP -3: PRINT i; : NEXT: PRINT
PRINT "C:"; : FOR x = 0 TO 1 STEP 0.25: PRINT x; : NEXT: PRINT
FOR i = 1 TO 3: PRINT "D"; i; ":"; : FOR j = 1 TO i: PRINT "*"; : NEXT j: PRINT : NEXT i
PRINT "E:"; : FOR k% = 1 TO 3: PRINT k%; : NEXT: PRINT
FOR i = 1 TO 100
  IF i = 4 THEN EXIT FOR
NEXT
PRINT "F:"; i
