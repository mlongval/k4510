# K4510: the SHIPPED default is plain US (Doc, 2026-09-10).  The boot menu
# offers other layouts; picking one passes k4510.kbd=<code> on the kernel
# command line, and k4510-keymap.service rewrites this file and re-applies it
# before the emulator starts, so SDL's console keyboard reads the chosen map.
# A downloader in Germany or Spain picks their layout at power-on -- no Linux,
# no tty2, no loadkeys.  Accent layouts (us-intl, de, es, fr, ca...) compose
# dead keys; plain US does not.
XKBMODEL="pc105"
XKBLAYOUT="us"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
