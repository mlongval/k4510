*.o
test/cputest
sdl/k4510
/k4510
# experimental rebuilds of the emulator kept beside the normal one, so a
# machine can run two and compare (hdieu, 2026-08-31: -O3 -ffast-math)
sdl/k4510-o3fast
/k4510-o3fast
rom/*.bin
rom/*.lst
test/maptest
test/dmatest
test/vickytest
test/capture
test/fstest
test/romtest
# rom/kernal.bin, wozmon.bin and demo.bin ARE tracked since 2026-09-07: a host without
# cc65 (p15, the Pi card) kept a ROM from before the SID cut for a week -- "why does
# it show 4 SIDs?"  The images are small and deterministic; check-artifacts guards them.
!rom/kernal.bin
!rom/wozmon.bin
!rom/demo.bin
rom/kernal.s
rom/*.o
rom/kernal.map
fs/out.bin
demo/*.o
demo/*.s
demo/*.map
basic/*.o
test/headless
test/banktest
!demo/segdemo-header.s
test/mathtest
test/seqtest
test/woztest
dumps/
!demo/tiny-header.s
!demo/prg0.s
!demo/rxasm.s
!demo/romcalls.s
doc/guide/shots/
doc/guide/*.aux
doc/guide/*.log
doc/guide/*.out
doc/guide/*.toc
doc/guide/*.pdf
# the built handbook travels with the repo -- not only in the release zip
!doc/guide/k4510-guide.pdf
tube/*.o
tube/bbcbasic
test/tubetest
test/tubetest.out
test/termtest
test/uitest
test/statetest
k4510-slot*.k4s
# Commodore's character ROM, if you drop one in /SYSTEM/ETC: not ours to publish
fs/SYSTEM/ETC/chargen.bin

# Your own OPL tune library.  tools/vgm2opl.py converts VGM/VGZ OPL2 logs into
# the .OPL files OPLPLAY reads; the music is nobody's here to redistribute, so
# it is not in the repository.  Absent, OPLPLAY plays its three built-in tunes.
fs/APPS/OPLPLAY/TUNES/

# your own startup script: yours, not the repo's (see /SYSTEM/ETC/STARTUP.SAMPLE)
fs/STARTUP.BAT
# and your own VI startup file (see /SYSTEM/ETC/VI.SAMPLE)
# the F7 menu's settings, written wherever the emulator was run from
/k4510.cfg

# the temp file *VI / *EDIT save the BASIC program through
fs/EDITTMP.BAS
doc/guide/version.tex
doc/guide/generated/
core/build.h

# dependency files the compiler writes beside objects; a stale one
# naming a renamed header broke the Pi build once
*.d
# ...but not DIRECTORIES so named: the Linux build's profile.d/ and *.service.d/ under
# linux/config were silently left out of every commit until 2026-09-06
!*.d/

# a convenience symlink into Doc's own Pictures folder, for handing
# screenshots to a session. It was tracked by accident: a clone got a
# dangling link to a path on one machine.
/screenshots
# ZX Origins fonts (Damien Guard): free to use, but the licence forbids
# re-hosting the files. Personal use only -- regenerate with tools/mkzxfonts.py
# from your own download; the menu falls back to kernel8 when they are absent.
data/fonts/zx/*.bin
demo/tiny.bin
demo/tiny.h
demo/bomber.h
# Written into the machine's own filesystem by the programs that measure it:
# PERF.TXT by the io profiler, BENCH-NN.TXT by SETUP/BENCH.  Results, not source.
fs/SYSTEM/LOG/*
!fs/SYSTEM/LOG/README.TXT
# /MNT is other disks: whatever is mounted there is not the repository's
fs/MNT/*
!fs/MNT/README.TXT
# /HOME is yours
fs/HOME/*
!fs/HOME/README.TXT
# LODE's levels: the three shipped ones are the repository's, the rest are yours
fs/APPS/LODE/LEVEL*.TXT
!fs/APPS/LODE/LEVEL01.TXT
!fs/APPS/LODE/LEVEL02.TXT
!fs/APPS/LODE/LEVEL03.TXT
linux/*.img
# build-live.sh works in here: a debootstrapped rootfs and a squashfs,
# about 2.5 GB. REUSE=1 rebuilds an image from it in seconds.
linux/.live-work/

# the browser build (wasm/build.sh); served from ~/containers/k4510web/site on ubuntu-s1
wasm/dist/

# a chess piece set of unknown licence: built where present, never shipped (data/chess/lines/VENDORED-FROM.txt)
data/chess/lines/*.png

# generated from data/ art by tools/mk*.py (Makefile)
demo/chess.bin
demo/chess.h
demo/fluffy.bin
demo/fluffy.h
demo/skyfire.bin
demo/skyfire.h
tools/__pycache__/
test/bench
