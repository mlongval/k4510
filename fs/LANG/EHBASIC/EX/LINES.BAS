10 REM SPINNING LINES - K4510 EHBASIC
20 GRAPHICS 2
30 FOR C=16 TO 31:PALETTE C,(C-15)*16,255-(C-15)*16,128+(C-15)*8:NEXT:REM COLOURS 0-15 ARE THE TEXT'S
40 A=0
50 FOR N=1 TO 400
60 X=320+280*COS(A):Y=240+200*SIN(A)
70 X2=320+280*COS(A+2):Y2=240+200*SIN(A+2)
80 LINE X,Y,X2,Y2,16+(N AND 15)
90 A=A+0.07
100 NEXT
110 PRINT "ANY KEY"
115 GET K$:IF K$="" THEN 115
120 GRAPHICS 0
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
