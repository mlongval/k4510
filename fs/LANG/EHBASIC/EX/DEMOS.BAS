10 REM K4510 EHBASIC DEMOS MENU. EACH DEMO CHAINS BACK HERE WHEN IT ENDS (PEEK(1039)=1).
20 POKE 1039,0: PRINT CHR$(12)
30 PRINT "K4510  EHBASIC DEMOS": PRINT
40 PRINT "  1  LINES    SPINNING LINES (BLITTER LINE OP)"
50 PRINT "  2  TRIS     300 RANDOM TRIANGLES"
60 PRINT "  3  SINE     SINE WAVES (MATH UNIT)"
70 PRINT "  4  STARS    A STARFIELD (ANY KEY LEAVES)"
80 PRINT "  5  README   HOW TO USE EHBASIC HERE"
89 PRINT "  I  INVADERS SPACE INVADERS ON THE TEXT SCREEN"
90 PRINT "  J  INVADER2 SPACE INVADERS WITH HARDWARE SPRITES"
91 PRINT "  G  GRAPH2D  PLOT Y=F(X), PAN AND ZOOM"
92 PRINT "  H  GRAPH3D  A SURFACE IN WIREFRAME, ROTATE IT"
93 PRINT "  B  BENCHMARKS MENU"
100 PRINT "  *  K/OS COMMANDS: *DIR, *CD /LANG/EHBASIC, *TYPE NAME, *INFO ... (@ WORKS TOO)"
110 PRINT "  Q  QUIT TO READY": PRINT
120 PRINT "CHOICE? ";
130 GET K$: IF K$="" THEN 130
140 PRINT K$: POKE 1039,1
150 IF K$="1" THEN LOAD "LINES.BAS"
160 IF K$="2" THEN LOAD "TRIS.BAS"
170 IF K$="3" THEN LOAD "SINE.BAS"
180 IF K$="4" THEN LOAD "STARS.BAS"
190 IF K$="5" THEN LOAD "/LANG/EHBASIC/README.BAS"
199 IF K$="I" OR K$="i" THEN LOAD "INVADERS.BAS"
200 IF K$="J" OR K$="j" THEN LOAD "INVADER2.BAS"
201 IF K$="G" OR K$="g" THEN LOAD "GRAPH2D.BAS"
202 IF K$="H" OR K$="h" THEN LOAD "GRAPH3D.BAS"
203 IF K$="B" OR K$="b" THEN LOAD "BENCH.BAS"
210 IF K$="Q" OR K$="q" THEN POKE 1039,0: END
220 GOTO 120
