#!/bin/sh
# tekplay [NAME|FILE...]  --  show Tektronix plot files on the Tek40xx terminal
# (no argument: every shipped plot in turn)
# without a PiDP-11: a tiny server on 127.0.0.1 sends each file (HOME on the
# terminal clears the page between them, END quits), and `tek` dials it.
# A bare name (k4510, gnu1...) is one of the plots shipped in linux/tek40xx/plt/
# as NAME.tek -- a Tektronix byte stream; a path is a file of your own.  A
# .plt file is a GNUPLOT SCRIPT, not a stream (the four gnu*.plt shipped are
# gnuplot's own tek40xx demos, and Doc watched them come out as text,
# 2026-09-09): it is rendered through gnuplot if there is one, else refused
# -- the shipped ones have their rendered .tek beside them.
# From the K4510 prompt:  !tekplay        or   !tekplay gnu2
export TEKPLAY=1              # tell tek40xx this is a plot viewer: ESC/q/Ctrl-C quit it
PLT=$(cd "$(dirname "$(readlink -f "$0")")/../linux/tek40xx/plt" 2>/dev/null && pwd)
# No argument: the whole shipped set, the test page first, a fresh page each.
if [ $# -lt 1 ]; then
    [ -n "$PLT" ] || { echo "tekplay: no shipped plots found beside this script; give a file" >&2; exit 2; }
    set -- k4510 $(ls "$PLT" | sed -n 's/\.tek$//p' | grep -v '^k4510$')
    echo "tekplay: $* -- HOME clears the page, ESC/q/END quits" >&2
fi
TMP=$(mktemp -d "${TMPDIR:-/tmp}/tekplay.XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT
set -- $(for f in "$@"; do
    if [ -r "$f" ]; then :
    elif [ -n "$PLT" ] && [ -r "$PLT/$f.tek" ]; then f="$PLT/$f.tek"
    elif [ -n "$PLT" ] && [ -r "$PLT/$f" ]; then f="$PLT/$f"
    else echo "tekplay: $f: no such file or shipped plot" >&2; exit 1; fi
    # a stream has GS, FS, ESC or US bytes in it (point plots use only FS and US); a gnuplot script is plain text
    # (rricharz's cassette plots are streams though they are named .plt)
    if LC_ALL=C tr -d -c '\033\034\035\037' < "$f" | head -c 1 | grep -q .; then echo "$f"
    elif command -v gnuplot >/dev/null 2>&1; then          # render the script to a stream first
        o="$TMP/$(basename "$f").tek"
        (echo "set terminal tek40xx"; cat "$f") | gnuplot > "$o" 2>"$TMP/err" || { echo "tekplay: gnuplot failed on $f:" >&2; head -3 "$TMP/err" >&2; exit 1; }
        echo "$o"
    elif [ -r "${f%.*}.tek" ]; then echo "${f%.*}.tek"      # its rendered twin, if shipped
    else echo "tekplay: $f is a gnuplot script (no Tektronix bytes in it) and there is no gnuplot here to render it" >&2; exit 1; fi
done) || exit 1
[ $# -ge 1 ] || exit 1
PORT=${TEKPLAY_PORT:-4010}
BAUD=${TEKPLAY_BAUD:-9600}                    # the pace; TEKPLAY_BAUD=115200 for the big grey-scale pictures
python3 - "$PORT" "$BAUD" "$@" <<'PY' &
import socket, sys, time
port = int(sys.argv[1]); baud = int(sys.argv[2]); files = sys.argv[3:]
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(("127.0.0.1", port)); s.listen(1)
c, _ = s.accept()
try:
    for i, f in enumerate(files):
        if i: c.sendall(b"\x1b\x0c"); time.sleep(0.3)          # ESC FF: a fresh page (a real 4010 took a second to erase)
        data = open(f, "rb").read()
        for j in range(0, len(data), 64):                      # 9600 baud, roughly: the drawing shows as it draws
            c.sendall(data[j:j + 64]); time.sleep(64 * 10 / baud)
        time.sleep(2)
    while c.recv(256): pass                                    # then hold the line until END on the terminal
except (BrokenPipeError, ConnectionResetError): pass
PY
SRV=$!
sleep 0.3
# the terminal: `tek` where the Linux build installed its wrapper, else the
# binary on PATH, else the one build.sh puts in ~/.local/bin on a desktop
# On the bare K4510 Linux the emulator itself owns the screen (KMSDRM on
# tty1), so a second SDL program on the SAME VT cannot open the display --
# "SDL_init fail: Video subsystem has not been initialized" (Doc, the Dell,
# 2026-09-11).  Inside `!` there (no desktop, and the emulator's
# K4510_PLACEMENT in the environment) run the terminal on a fresh VT instead:
# openvt switches to it, waits, and switches back, and the emulator gives up
# and retakes the display across the switch -- what the tty2 recipe did by hand.
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && [ -n "$K4510_PLACEMENT" ] \
   && command -v openvt >/dev/null 2>&1 && command -v tek >/dev/null 2>&1; then
    sudo -n openvt -s -w -- env TEKPLAY=1 K4510_PLACEMENT="$K4510_PLACEMENT" tek 127.0.0.1 "$PORT"
elif command -v tek >/dev/null 2>&1; then tek 127.0.0.1 "$PORT"
elif command -v tek40xx >/dev/null 2>&1; then tek40xx 127.0.0.1 "$PORT"
elif [ -x "$HOME/.local/bin/tek40xx" ]; then "$HOME/.local/bin/tek40xx" 127.0.0.1 "$PORT"
else
    echo "tekplay: no Tektronix terminal here yet.  Build it once (no root needed on a desktop):" >&2
    echo "    sh $(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/linux/tek40xx/build.sh" >&2
    kill $SRV 2>/dev/null; exit 1
fi
kill $SRV 2>/dev/null; wait $SRV 2>/dev/null
