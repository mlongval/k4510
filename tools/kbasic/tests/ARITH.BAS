PRINT "A:"; 2 + 3 * 4
PRINT "B:"; (2 + 3) * 4
PRINT "C:"; 2 ^ 10
PRINT "D:"; -2 ^ 2
PRINT "E:"; 17 MOD 5
PRINT "F:"; 17 \ 5
PRINT "G:"; 7 / 2
a% = 11 / 3: PRINT "H:"; a%
PRINT "I:"; 2 ^ 0.5
PRINT "J:"; SQR(16)
PRINT "K:"; INT(-3.5); FIX(-3.5)
PRINT "L:"; ABS(-7); SGN(-7); SGN(0)
PRINT "M:"; 1 + 2 = 3
x = 5: PRINT "N:"; x > 3 AND x < 10
PRINT "O:"; 6 AND 3
PRINT "P:"; NOT 0
