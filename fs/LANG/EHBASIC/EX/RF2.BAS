1 REM RUGG/FELDMAN BENCHMARK 2 (KILOBAUD/PCW, 1977) (THE S/E STOPWATCH MARKS DROPPED)
4 PRINT CHR$(12);"RUGG/FELDMAN BENCHMARK 2 (1977)"
5 PRINT "1000 LOOPS BUILT FROM IF/GOTO: A LINE LOOKUP EVERY TIME ROUND"
6 PRINT
10 T=PEEK(54541)+256*PEEK(54542): REM THE 60 HZ FRAME COUNTER
400 K=0
500 K=K+1
600 IF K<1000 THEN 500
750 T=PEEK(54541)+256*PEEK(54542)-T: IF T<0 THEN T=T+65536
755 S=INT(T/0.6+0.5)/100: IF S=0 THEN S=0.01
760 PRINT: PRINT "THIS MACHINE: ";MID$(STR$(S),2);" SECONDS"
765 PRINT
770 PRINT "THE SAME PROGRAM ON (STOPWATCH-ERA FIGURES, APPROXIMATE):"
775 C=9.3: B=3.1
780 PRINT "  C64 AND APPLE IIE (1 MHZ, MS BASIC)  ";MID$(STR$(C),2);" S  (";MID$(STR$(INT(C/S+0.5)),2);"X SLOWER)"
782 PRINT "  BBC MICRO B (2 MHZ, BBC BASIC)       ";MID$(STR$(B),2);" S  (";MID$(STR$(INT(B/S+0.5)),2);"X)"
784 PRINT "  MEGA65 (40.5 MHZ, BASIC65), ROUGHLY  ";MID$(STR$(0.23),2);" S"
790 PRINT: PRINT "METRIC: TOTAL RUN TIME OF THIS EXACT PROGRAM, SELF-TIMED."
800 GOTO 900
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
