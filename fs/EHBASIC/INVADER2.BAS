
1 REM SPACE INVADERS WITH HARDWARE SPRITES (SPRITE/SPRDEF/SPROFF ARE K4510
2 REM EHBASIC STATEMENTS; SEE INVADERS.BAS FOR THE TEXT-SCREEN VERSION).
3 REM SHAPES ARE POKED 4BPP INTO $040000 THROUGH BANK REGISTER 4 ($8000, CLEAR
4 REM OF THE PROGRAM TEXT, WHICH STARTS AT $0800 AND OUTGREW $2000); THE FOUR
4 REM BASES EACH OWN A SHAPE PAGE AND HITS POKE HOLES INTO IT (EROSION).
5 REM A/D OR CURSORS MOVE, SPACE FIRES, Q QUITS.
6 REM SPEEDS COME FROM /EHBASIC/INVADER2.CFG (LINE 9500 READS IT); THESE ARE THE DEFAULTS
7 PS=8: BS=10: ES=6: MS=4: MI=20: MD=3: MN=3: FC=20: FW=5
8 X=RND(PEEK(54541)+1): REM SEED THE RNG (UNSEEDED, RND(0) IS 0 FOREVER)
10 POKE 54800,0: POKE 54801,0: POKE 54802,4: POKE 54803,0: REM BANK 4 ($8000) -> $040000
15 GOSUB 9500
20 PALETTE 17,80,255,120: PALETTE 18,255,255,255: PALETTE 19,255,220,80: PALETTE 20,255,80,80: PALETTE 21,120,255,180
30 REM ---- SHAPES: THE ARCADE ORIGINALS, 16 ROWS OF 15-BIT MASKS; 6-8 ARE THE ALIENS' SECOND FRAME ----
40 RESTORE: FOR S=0 TO 8: READ C: FOR R=0 TO 15: READ M: B=32768+S*256+R*8
50 FOR X=0 TO 7: P=0: IF M AND INT(2^(14-X*2)) THEN P=C*16
60 IF M AND INT(2^(13-X*2)) THEN P=P+C
70 POKE B+X,P: NEXT: NEXT: NEXT
90 REM SQUID (TOP ROW, 30 PTS)
92 DATA 2, 384,960,2016,3504,4080,576,1440,2640,0,0,0,0,0,0,0,0
100 REM CRAB (MIDDLE, 20 PTS)
102 DATA 3, 1040,544,2032,3544,8188,6132,5140,864,0,0,0,0,0,0,0,0
110 REM OCTOPODES (BOTTOM ROW, 10 PTS -- GREEK PLURAL, AS THE ETYMOLOGY DEMANDS)
112 DATA 1, 960,8184,16380,14748,16380,3696,6552,12300,0,0,0,0,0,0,0,0
120 REM PLAYER CANNON
122 DATA 5, 128,448,448,8188,16382,16382,16382,16382,0,0,0,0,0,0,0,0
130 REM BULLET
132 DATA 2, 1024,1024,1024,1024,1024,1024,1024,1024,0,0,0,0,0,0,0,0
140 REM BOMB
142 DATA 4, 64,32,64,128,64,32,64,128,0,0,0,0,0,0,0,0
145 REM THE SECOND FRAMES: THE LEGS THE OTHER WAY, SO THE MARCH WALKS
146 DATA 2, 384,960,2016,3504,4080,1440,2064,1056,0,0,0,0,0,0,0,0
147 DATA 3, 1040,4644,6132,7644,8188,4088,1040,2056,0,0,0,0,0,0,0,0
148 DATA 1, 960,8184,16380,14748,16380,1632,3504,12300,0,0,0,0,0,0,0,0
155 REM ---- THE FOUR BASES: 32X16, PAGES 1036-1039, SOLID WITH AN ARCH ----
160 FOR B=0 TO 3: BB=32768+(12+B)*256
165 FOR R=0 TO 15: FOR X=0 TO 15: P=85: REM COLOUR 5|5 -> 21,21
170 IF R>10 AND X>3 AND X<12 THEN P=0: REM THE ARCH
175 IF R<2 AND (X<2 OR X>13) THEN P=0: REM ROUNDED SHOULDERS
180 POKE BB+R*16+X,P: NEXT: NEXT: NEXT
190 SC=0: LI=3: WV=1: DIM A(24)
200 PRINT CHR$(12): PRINT "  INVADERS WITH SPRITES   A/D OR CURSORS, SPACE FIRES, Q QUITS"
205 SPRDEF 0,1027,16,16,4
206 FOR I=1 TO 8: SPRDEF I,1024,16,16,4: NEXT
207 FOR I=9 TO 16: SPRDEF I,1025,16,16,4: NEXT
208 FOR I=17 TO 24: SPRDEF I,1026,16,16,4: NEXT
210 SPRDEF 25,1028,16,16,4: SPRDEF 26,1029,16,16,4
215 FOR B=0 TO 3: SPRDEF 27+B,1036+B,32,16,4: SPRITE 27+B,80+B*140,192: NEXT
220 REM ---- NEW WAVE ----
225 NA=24: FOR I=1 TO 24: A(I)=1: NEXT: FR=0
230 GX=80: GY=40: DI=MS: MM=MI-(WV-1)*MD: IF MM<MN THEN MM=MN
240 MC=MM: PX=312: OP=0: BY=0: EY=0
250 GOSUB 8000: SPRITE 0,PX,220
260 REM ---- MAIN LOOP, ONCE PER FRAME ----
270 TF=PEEK(54541)
280 IF PEEK(54541)=TF THEN 280
290 GET K$: IF K$="" THEN 340: REM COALESCE: EVERY QUEUED KEY, THEN ONE DRAW
300 IF K$="Q" OR K$="q" THEN 700
310 IF (K$="A" OR K$="a" OR K$=CHR$(130)) AND PX>PS THEN PX=PX-PS
320 IF (K$="D" OR K$="d" OR K$=CHR$(131)) AND PX<608-PS THEN PX=PX+PS
330 IF K$=" " AND BY=0 THEN BY=212: BX=PX: SPRITE 25,BX,BY
335 GOTO 290
340 IF PX<>OP THEN SPRITE 0,PX,220: OP=PX
350 IF BY THEN GOSUB 8200
360 IF EY THEN GOSUB 8400
370 IF EY=0 AND RND(0)*1000<FC+WV*FW THEN GOSUB 8300
380 MC=MC-1: IF MC=0 THEN MC=MM: GOSUB 8100
390 IF NA=0 THEN WV=WV+1: PRINT "WAVE CLEARED": FOR I=1 TO 60: GOSUB 9100: NEXT: GOTO 220
400 GOTO 270
700 REM ---- GAME OVER ----
710 PRINT "GAME OVER  SCORE";SC
720 FOR I=0 TO 30: SPROFF I: NEXT
730 POKE 54803,255
740 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
750 END
8000 REM DRAW THE LIVE GRID
8010 FOR R=0 TO 2: FOR C=0 TO 7: I=R*8+C+1
8020 IF A(I) THEN SPRITE I,GX+C*40,GY+R*24
8030 NEXT: NEXT: RETURN
8100 REM MARCH: A STEP, AND THE OTHER FRAME -- THE LEGS WALK
8105 FR=1-FR: FOR I=1 TO 24: IF A(I) THEN SPRDEF I,1024+INT((I-1)/8)+FR*6,16,16,4
8107 NEXT
8110 GX=GX+DI
8120 IF GX<8 OR GX>320 THEN DI=-DI: GX=GX+DI: GY=GY+10: MM=MM-1: IF MM<MN THEN MM=MN
8130 IF GY>170 THEN LI=0: GOTO 700
8140 GOSUB 8000: RETURN
8200 REM BULLET UP
8210 BY=BY-BS: IF BY<20 THEN BY=0: SPROFF 25: RETURN
8220 SPRITE 25,BX,BY
8225 IF BY>176 AND BY<210 THEN HX=BX+7: HY=BY+2: GOSUB 8600: IF HH THEN BY=0: SPROFF 25: RETURN
8230 C=INT((BX-GX+8)/40): R=INT((BY-GY+8)/24)
8240 IF C<0 OR C>7 OR R<0 OR R>2 THEN RETURN
8250 I=R*8+C+1: IF A(I)=0 THEN RETURN
8260 IF ABS(BX-(GX+C*40))<12 AND ABS(BY-(GY+R*24))<12 THEN A(I)=0: NA=NA-1: SC=SC+10: SPROFF I: SPROFF 25: BY=0: PRINT "SCORE";SC
8270 RETURN
8300 REM THE LOWEST INVADER OF A RANDOM COLUMN FIRES
8310 C=INT(RND(0)*8): FOR R=2 TO 0 STEP -1: I=R*8+C+1
8320 IF A(I) THEN EX=GX+C*40: EY=GY+R*24+16: SPRITE 26,EX,EY: R=0
8330 NEXT: RETURN
8400 REM BOMB DOWN
8410 EY=EY+ES: IF EY>236 THEN EY=0: SPROFF 26: RETURN
8420 SPRITE 26,EX,EY
8425 IF EY>176 AND EY<208 THEN HX=EX+7: HY=EY+13: GOSUB 8600: IF HH THEN EY=0: SPROFF 26: RETURN
8430 IF EY>208 AND ABS(EX-PX)<12 THEN GOSUB 8500
8440 RETURN
8500 REM PLAYER HIT
8510 LI=LI-1: EY=0: SPROFF 26: PRINT "OUCH! LIVES";LI
8520 IF LI=0 THEN 700
8530 RETURN
8600 REM HIT TEST AGAINST THE BASES AT (HX,HY); ERODE ON HIT. HH=1 IF HIT.
8605 REM QX, NOT BX0: EHBASIC READS ONLY TWO CHARACTERS OF A NAME -- BX0 IS BX
8610 HH=0: IF HY<192 OR HY>207 THEN RETURN
8620 FOR B=0 TO 3: QX=80+B*140
8630 LX=HX-QX: IF LX<0 OR LX>31 THEN 8680
8640 LY=HY-192: BB=32768+(12+B)*256+LY*16+INT(LX/2)
8650 IF PEEK(BB)=0 THEN 8680
8660 HH=1: FOR YY=LY-1 TO LY+2: IF YY<0 OR YY>15 THEN 8675
8665 FOR XX=INT(LX/2)-2 TO INT(LX/2)+2: IF XX>=0 AND XX<=15 THEN POKE 32768+(12+B)*256+YY*16+XX,0
8670 NEXT
8675 NEXT: B=3
8680 NEXT: RETURN
9100 TF=PEEK(54541)
9110 IF PEEK(54541)=TF THEN 9110
9120 RETURN
9500 REM ---- READ /EHBASIC/INVADER2.CFG: "NAME VALUE" LINES, ANYTHING ELSE IGNORED ----
9505 REM THE FILE DEVICE AT $D300 (54016) LOADS IT WHOLE INTO $041100 (SEEN AT 37120 THROUGH BANK 4)
9510 N$="/EHBASIC/INVADER2.CFG": FOR J=1 TO LEN(N$): POKE 36863+J,ASC(MID$(N$,J,1)): NEXT: POKE 36864+LEN(N$),0
9515 POKE 54020,0: POKE 54021,16: POKE 54022,4: POKE 54023,0: REM NAME AT $041000
9520 POKE 54024,0: POKE 54025,17: POKE 54026,4: POKE 54027,0: REM BUFFER AT $041100
9525 POKE 54016,9: IF PEEK(54017) THEN RETURN: REM NO FILE: THE DEFAULTS STAND
9530 L=PEEK(54028)+256*PEEK(54029): IF L>3000 THEN L=3000
9535 J=0
9540 IF J>=L THEN RETURN
9545 C=PEEK(37120+J): IF C<65 OR C>90 THEN GOSUB 9590: GOTO 9540: REM NOT A LETTER: SKIP THE LINE
9548 W$=""
9550 IF C>=65 AND C<=90 THEN W$=W$+CHR$(C): J=J+1: C=PEEK(37120+J): GOTO 9550
9555 V=0: IF C=32 THEN J=J+1: C=PEEK(37120+J): GOTO 9555
9560 IF C>=48 AND C<=57 THEN V=V*10+C-48: J=J+1: C=PEEK(37120+J): GOTO 9560
9565 IF W$="PLAYER" THEN PS=V
9566 IF W$="BULLET" THEN BS=V
9567 IF W$="BOMB" THEN ES=V
9568 IF W$="STEP" THEN MS=V
9569 IF W$="MARCH" THEN MI=V
9570 IF W$="FASTER" THEN MD=V
9571 IF W$="FASTEST" THEN MN=V
9572 IF W$="FIRE" THEN FC=V
9573 IF W$="FIREWAVE" THEN FW=V
9580 GOSUB 9590: GOTO 9540
9590 IF J<L AND PEEK(37120+J)<>10 THEN J=J+1: GOTO 9590
9595 J=J+1: RETURN
