' K4510 BASIC demos menu.  Each demo is its own program: the menu runs it
' through the shell (SHELL "LINES") and comes back here when it ends.
DO
  CLS
  PRINT "K4510 BASIC DEMOS  (EACH ONE COMPILED)": PRINT
  PRINT "  1  LINES    SPINNING LINES (BLITTER LINE OP)"
  PRINT "  2  TRIS     300 RANDOM TRIANGLES"
  PRINT "  3  SINE     SINE WAVES"
  PRINT "  4  STARS    A STARFIELD (ANY KEY LEAVES)"
  PRINT "  5  README   HOW TO USE K4510 BASIC"
  PRINT "  I  INVADERS SPACE INVADERS ON THE TEXT SCREEN"
  PRINT "  J  INVADER2 SPACE INVADERS WITH HARDWARE SPRITES"
  PRINT "  G  GRAPH2D  PLOT Y=F(X), PAN AND ZOOM"
  PRINT "  H  GRAPH3D  A SURFACE IN WIREFRAME, ROTATE IT"
  PRINT "  P  SPLIT    A BITMAP ABOVE, TEXT BELOW (SHEILA)"
  PRINT "  R  RES      SCREEN SIZES: MODE WXH, SMOOTHED, SCANLINES"
  PRINT "  T  TEST     THE SELF-TEST"
  PRINT "  B  BENCHMARKS MENU"
  PRINT "  Q  QUIT": PRINT
  PRINT "CHOICE? ";
  DO: GET k$: LOOP UNTIL k$ <> ""
  PRINT k$
  SELECT CASE UCASE$(k$)
    CASE "1": SHELL "LINES"
    CASE "2": SHELL "TRIS"
    CASE "3": SHELL "SINE"
    CASE "4": SHELL "STARS"
    CASE "5": SHELL "README"
    CASE "I": SHELL "INVADERS"
    CASE "J": SHELL "INVADER2"
    CASE "G": SHELL "GRAPH2D"
    CASE "H": SHELL "GRAPH3D"
    CASE "P": SHELL "SPLIT"
    CASE "R": SHELL "RES"
    CASE "T": SHELL "TEST"
    CASE "B": SHELL "BENCH"
    CASE "Q": EXIT DO
  END SELECT
LOOP
