100 REM STRING HANDLING -- X16 BASIC
110 REM FIVE ROUNDS OF: BUILD A 200-CHARACTER STRING ONE CHR$ AT A
120 REM TIME, REVERSE IT WITH MID$, COUNT ITS VOWELS, 200 STR$/VAL
130 REM ROUND TRIPS, 100 LEFT$/RIGHT$ COMPARISONS.  THE INTERPRETER
140 REM COLLECTS ITS STRING GARBAGE ALONG THE WAY: THAT IS PART OF IT.
150 PRINT "STRING HANDLING, X16 BASIC"
200 T=TI
210 FOR R=1 TO 5
220 A$=""
230 FOR I=1 TO 200:A$=A$+CHR$(65+(I AND 15)):NEXT
240 B$=""
250 FOR I=LEN(A$) TO 1 STEP -1:B$=B$+MID$(A$,I,1):NEXT
260 V=0
270 FOR I=1 TO LEN(A$):C$=MID$(A$,I,1)
280 IF C$="A" OR C$="E" OR C$="I" OR C$="O" THEN V=V+1
290 NEXT
300 S=0
310 FOR I=1 TO 200:S=S+VAL(STR$(I*3)):NEXT
320 W=0
330 FOR I=1 TO 100:IF LEFT$(A$,I)<RIGHT$(A$,I) THEN W=W+1
340 NEXT
350 NEXT R
360 T=TI-T
370 PRINT "CHECK";LEN(B$);V;S;W
380 PRINT "RESULT STRINGS";T/60;"S"
390 PRINT "DONE"
