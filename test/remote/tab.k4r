# test/remote/tab.k4r -- Tab in VI puts spaces to the next stop (4 unless
# VI.RC says set ts=N), never a tab character.
#     tools/k4510-remote run test/remote/tab.k4r
key esc
# the machine's own colours first: a STARTUP.BAT may load another palette (Doc, 2026-09-15)
type PALETTE RESET\n
wait 1
type CD /HOME\n
type RM -f TABT.C\n
wait 1
type VI TABT.C\n
expect "TABT.C" 10
type i
key tab
type x
key esc
type :wq\n
expect "/HOME]" 10
type TYPE TABT.C\n
expect "    x" 5
# leave /HOME as it was: the files this test made go (Doc, 2026-09-15: /HOME had filled with them)
type CD /HOME\n
type RM -f TABT.C\n
wait 1
