10 REM GRAPH2D - AN INTERACTIVE FUNCTION PLOTTER (640X480, MATH UNIT)
20 REM ARROWS PAN, +/- ZOOM, 1-8 PICK THE FUNCTION, Q QUITS
30 GRAPHICS 2
40 PALETTE 16,255,255,255:PALETTE 17,90,90,120:PALETTE 18,255,150,0
50 CX=0:CY=0:W=13:F=1
100 REM ---- REDRAW ----
110 HH=W*0.75:GCLS:PRINT CHR$(12)
120 GOSUB 3000
130 REM AXES AND TICKS
140 TS=1:IF W>26 THEN TS=5
145 IF W>130 THEN TS=25
150 X0=640*(0-(CX-W/2))/W:Y0=480-480*(0-(CY-HH/2))/HH
160 IF X0>=0 AND X0<640 THEN LINE X0,0,X0,479,16
170 IF Y0>=0 AND Y0<480 THEN LINE 0,Y0,639,Y0,16
180 IF Y0<0 OR Y0>479 THEN 230
190 T=TS*INT((CX-W/2)/TS)
200 IF T>CX+W/2 THEN 230
210 TX=640*(T-(CX-W/2))/W:IF TX>=0 AND TX<640 THEN LINE TX,Y0-3,TX,Y0+3,17
220 T=T+TS:GOTO 200
230 IF X0<0 OR X0>639 THEN 300
240 T=TS*INT((CY-HH/2)/TS)
250 IF T>CY+HH/2 THEN 300
260 TY=480-480*(T-(CY-HH/2))/HH:IF TY>=0 AND TY<480 THEN LINE X0-3,TY,X0+3,TY,17
270 T=T+TS:GOTO 250
300 REM ---- THE CURVE, LEFT TO RIGHT, JOINED WHERE IT IS CONTINUOUS ----
310 P9=0
320 FOR PX=0 TO 639 STEP 2
330 X=CX-W/2+PX*W/640:VF=1:ON F GOSUB 2010,2020,2030,2040,2050,2060,2070,2080
340 IF VF=0 THEN P9=0:GOTO 390
350 PY=480-480*(Y-(CY-HH/2))/HH
360 IF PY<0 OR PY>479 THEN P9=0:GOTO 390
370 IF P9 THEN LINE Q1,Q2,PX,PY,18
375 IF P9=0 THEN PLOT PX,PY,18
380 Q1=PX:Q2=PY:P9=1
390 NEXT
400 REM ---- KEYS ----
410 GET K$:IF K$="" THEN 410
420 IF K$=CHR$(130) THEN CX=CX-W/8:GOTO 100
430 IF K$=CHR$(131) THEN CX=CX+W/8:GOTO 100
440 IF K$=CHR$(128) THEN CY=CY+HH/8:GOTO 100
450 IF K$=CHR$(129) THEN CY=CY-HH/8:GOTO 100
460 IF K$="+" THEN W=W/2:GOTO 100
470 IF K$="-" THEN W=W*2:GOTO 100
480 IF K$>="1" AND K$<="8" THEN F=VAL(K$):CX=0:CY=0:W=13:GOTO 100
490 IF K$="Q" OR K$="q" THEN GRAPHICS 0:GOTO 990
500 GOTO 410
2010 Y=SIN(X):RETURN
2020 Y=COS(X):RETURN
2030 Y=TAN(X):IF ABS(Y)>1E3 THEN VF=0
2035 RETURN
2040 Y=X*X/10:RETURN
2050 Y=SQR(ABS(X)):RETURN
2060 IF ABS(X)<0.001 THEN VF=0:RETURN
2065 Y=1/X:RETURN
2070 Y=EXP(X/3):RETURN
2080 IF ABS(X)<0.001 THEN VF=0:RETURN
2085 Y=LOG(ABS(X)):RETURN
3000 REM THE STATUS LINE, ON THE TEXT SCREEN UNDER THE BITMAP
3010 F$="SIN(X)":IF F=2 THEN F$="COS(X)"
3020 IF F=3 THEN F$="TAN(X)"
3030 IF F=4 THEN F$="X*X/10"
3040 IF F=5 THEN F$="SQR(ABS(X))"
3050 IF F=6 THEN F$="1/X"
3060 IF F=7 THEN F$="EXP(X/3)"
3070 IF F=8 THEN F$="LOG(ABS(X))"
3080 PRINT "F";F;" Y=";F$;"  X ";INT((CX-W/2)*10)/10;" TO ";INT((CX+W/2)*10)/10;
3090 PRINT "  ARROWS PAN  +/- ZOOM  1-8 FN  Q QUIT"
3100 RETURN
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
