10 REM A BOUNCING BALL WITH A BLIP
20 MODE 1
30 X=200:Y=800:U=14:V=0
40 REPEAT
50 GCOL 0,0:CIRCLE FILL X,Y,40
60 V=V-1.2:X=X+U:Y=Y+V
70 IF X>1240 OR X<40 THEN U=-U:SOUND 1,-10,100,1
80 IF Y<40 THEN Y=40:V=-V*0.94:SOUND 1,-10,60,1
90 IF ABS(V)<0.5 AND Y<45 THEN V=22
100 GCOL 0,1:CIRCLE FILL X,Y,40
110 WAIT 2
120 UNTIL FALSE
