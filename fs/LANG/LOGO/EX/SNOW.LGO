TO EDGE :LEN :DEPTH
  IFELSE :DEPTH = 0 [FD :LEN] [
    EDGE :LEN / 3 :DEPTH - 1
    LT 60
    EDGE :LEN / 3 :DEPTH - 1
    RT 120
    EDGE :LEN / 3 :DEPTH - 1
    LT 60
    EDGE :LEN / 3 :DEPTH - 1
  ]
END
TO SNOWFLAKE :LEN :DEPTH
  REPEAT 3 [EDGE :LEN :DEPTH RT 120]
END
CS
PU SETXY -150 90 PD
SETPC 15
SNOWFLAKE 300 3
