1 REM AHL'S SIMPLE BENCHMARK (CREATIVE COMPUTING, 1983), VERBATIM LINES 10-110
3 X=RND(1): REM EHBASIC STARTS WITH A ZERO SEED; RND(0) WOULD RETURN 0 FOREVER
4 PRINT CHR$(12);"AHL'S SIMPLE BENCHMARK (CREATIVE COMPUTING, 1983)"
5 PRINT "100 ROUNDS OF TEN SQR(A) THEN TEN A^2, PLUS RANDOM SUMS."
6 PRINT
7 T=PEEK(54541)+256*PEEK(54542)
10 REM AHL'S SIMPLE BENCHMARK
20 FOR N=1 TO 100: A=N
30 FOR I=1 TO 10
40 A=SQR(A): R=R+RND(0)
50 NEXT I
60 FOR I=1 TO 10
70 A=A^2: R=R+RND(0)
80 NEXT I
90 S=S+A: NEXT N
100 AC=ABS(1010-S/5)
110 RA=ABS(1000-R)
750 T=PEEK(54541)+256*PEEK(54542)-T: IF T<0 THEN T=T+65536
755 SC=INT(T/0.6+0.5)/100
760 PRINT "THIS MACHINE: ";MID$(STR$(SC),2);" SECONDS"
762 PRINT "ACCURACY ";MID$(STR$(AC),2);"  (HOW FAR TEN SQR THEN TEN ^2 DRIFT: SMALLER IS BETTER)"
764 PRINT "RANDOM ";MID$(STR$(RA),2);"  (SPREAD OF THE RANDOM SUMS: UNDER 15 IS GOOD)"
765 PRINT
770 PRINT "THE SAME PROGRAM ON (FROM THE MARCH 1984 ARTICLE):"
780 PRINT "  C64 AND APPLE IIE (1 MHZ, MS BASIC)   1:53"
782 PRINT "  TRS-80 MODEL III                      1:59"
784 PRINT "  IBM PC / COMPILED                     0:24 / 0:06"
790 PRINT: PRINT "METRIC: TOTAL RUN TIME, SELF-TIMED, PLUS THE ARTICLE'S TWO QUALITY SCORES."
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
