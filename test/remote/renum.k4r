# test/remote/renum.k4r -- the title trail and VI's :renum, from BBC BASIC (EhBASIC's half went with it, 2026-10-09).
#     tools/k4510-remote run test/remote/renum.k4r
# Letters in their real case (with Caps Lock on they would arrive inverted).
key esc
# the machine's own colours first: a STARTUP.BAT may load another palette (Doc, 2026-09-15)
type PALETTE RESET\n
wait 1
type CD /HOME\n
type BBC\n
expect "*QUIT returns" 10
type NEW\n
type 10 PRINT "BBC"\n
type 20 GOTO 10\n
type *VI\n
expect "EDITTMP.BBC" 10
shot renum-bbc-vi
type :renum 100\n
expect "renumbered 2 lines" 5
type :wq\n
expect "LOAD" 10
type LIST\n
expect "110 GOTO 100" 10
type *QUIT\n
expect "/HOME]" 10
# leave /HOME as it was: the files this test made go (Doc, 2026-09-15: /HOME had filled with them)
type CD /HOME\n
wait 1
