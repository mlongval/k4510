#!/bin/sh
# k4510-shot -- a screenshot of the running K4510; prints the file's path.
#
# Sends the emulator SIGUSR1.  It writes shots/shot-<date>-<time>-<ms>.png in
# its own directory (the checkout): the machine's picture, one row per line,
# the F7 menu if it is open, no scanlines.  PrtSc in the emulator does the
# same.  Made for the Dell (Doc, 2026-09-12), whose KMSDRM screen cannot be
# grabbed from outside:
#
#     ssh k4510@<the machine> k4510-shot      then copy the file it names
#     !k4510-shot                             from the machine's own prompt
pid=$(pgrep -nx k4510) || { echo "k4510-shot: no emulator running" >&2; exit 1; }
dir=$(readlink "/proc/$pid/cwd")/shots
before=$(ls -1 "$dir"/shot-*.png 2>/dev/null | tail -n 1)
kill -USR1 "$pid" || exit 1
i=0
while [ $i -lt 50 ]; do                      # five seconds: a frame is 17 ms, unless paused hard
    now=$(ls -1 "$dir"/shot-*.png 2>/dev/null | tail -n 1)
    if [ -n "$now" ] && [ "$now" != "$before" ]; then echo "$now"; exit 0; fi
    sleep 0.1; i=$((i + 1))
done
echo "k4510-shot: no picture came (an emulator from before 2026-09-12?)" >&2
exit 1
