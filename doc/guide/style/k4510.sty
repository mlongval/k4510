% k4510.sty -- visual language for the K4510 User's and Programmer's Guide.
% The colours are the machine's own boot palette (the C64 palette VICKY loads
% at reset; see rom/kernal.c c64pal[]): blue ground, yellow ink, white titles.
% Layout follows the Neo6502 handbook, which follows the MEGA65 User's Guide.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/k4510}[2026/08/24 K4510 guide style]
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{microtype}
\setlength{\emergencystretch}{1.5em}  % monospace words do not hyphenate; let lines breathe
\RequirePackage{caption}
\RequirePackage{fancyvrb}
\RequirePackage[hidelinks]{hyperref}
\tcbuselibrary{skins,breakable}
% A monospace path that may break at / and . -- long paths in a narrow
% A5 measure otherwise run straight off the right margin.
\DeclareUrlCommand\pth{\urlstyle{tt}}
\captionsetup{font=small, labelfont=bf, justification=raggedright,
              singlelinecheck=false, skip=4pt}
% The machine's palette (rom/kernal.c)
\definecolor{kblue}    {HTML}{0000AA}
\definecolor{kyellow}  {HTML}{EEEE77}
\definecolor{kwhite}   {HTML}{FFFFFF}
\definecolor{klblue}   {HTML}{0088FF}
\definecolor{kgrey}    {HTML}{777777}
\definecolor{kred}     {HTML}{880000}
\definecolor{kgreen}   {HTML}{00CC55}
\definecolor{korange}  {HTML}{DD8855}
\colorlet{kheading}{kblue}
\colorlet{krule}{kgrey}
\setmainfont{Clear Sans}[
  BoldFont       = Clear Sans Bold,
  ItalicFont     = Clear Sans Italic,
  BoldItalicFont = Clear Sans Bold Italic ]
\setmonofont{Iosevka NFM}[Scale=0.92]
% Pages end where the text ends: with this many screenshots, stretching a
% short page to the bottom margin opens gaps you can drive a bus through.
\raggedbottom
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[RE,LO]{\small\itshape\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\titleformat{\chapter}[display]
  {\raggedright\color{kheading}\bfseries}
  {\Large Chapter \thechapter}{4pt}{\huge}
\titleformat{name=\chapter,numberless}[display]
  {\raggedright\color{kheading}\bfseries}
  {}{0pt}{\huge}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}
% a screenshot of the machine, full measure, thin rule around it
% Let a screenshot take most of a page and still share it with text:
% LaTeX's defaults are tuned for journals and would rather make a page of
% pictures than put one at the top of a text page.
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.80}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.85}
\setcounter{topnumber}{2}
% Inside a box (an aside) a float is illegal -- LaTeX says "Not in outer par
% mode" and drops the picture. \screeninline is the old fixed block, for there.
\newcommand{\screeninline}[2]{%
  \begin{center}
  \fbox{\includegraphics[width=0.95\linewidth]{#1}}\\[2pt]
  {\small #2}
  \end{center}}
% A float, not a fixed block: a screenshot that will not fit leaves half a
% page empty if it cannot move, and this book is mostly screenshots.
\newcommand{\screen}[2]{%
  \begin{figure}[htbp]\centering
  \fbox{\includegraphics[width=0.95\linewidth]{#1}}\\[2pt]
  {\small #2}
  \end{figure}}
% what you type, machine-style
\newenvironment{type}
  {\VerbatimEnvironment\begin{tcolorbox}[colback=kblue,colframe=kblue,boxrule=0pt,
     left=6pt,top=4pt,bottom=4pt]\color{kyellow}\begin{Verbatim}[fontsize=\small]}
  {\end{Verbatim}\end{tcolorbox}}
% an aside
\newtcolorbox{aside}{colback=kyellow!18!white,colframe=korange,boxrule=0.8pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,breakable}
% --- the register appendix ----------------------------------------------
% Appendix A is generated from the machine's headers (doc/guide/mkregs.py).
% It is a reference, so it is set as one: an address column the eye can run
% down at a fixed left edge, the description in the book's own text face,
% and monospace kept for the things that are code. Twelve pages of folded
% \verbatim, which is what this replaced, is not a reference.
\newlength{\regcol}\setlength{\regcol}{5.9em}
\newenvironment{regblock}
  {\par\small\sloppy\setlength{\parskip}{2.5pt plus 1pt}\setlength{\parindent}{0pt}}
  {\par\medskip}
\newcommand{\rn}[1]{\textbf{\texttt{#1}}}          % a register's name
\newcommand{\racc}[1]{\textit{#1}}                 % R:, W:, RW:
% An entry: the address in its column, the description hanging past it.
\newcommand{\reg}[2]{\par\hangindent\regcol\hangafter=1\noindent
  \makebox[\regcol][l]{\texttt{#1}}#2\par}
% The same, for an address too wide for the column (a long range).
\newcommand{\reglong}[2]{\par\hangindent\regcol\hangafter=1\noindent
  \texttt{#1}\hspace{0.5em}#2\par}
% A remark that belongs to the entries around it, not to one of them.
\newcommand{\regnote}[1]{\par\hangindent\regcol\hangafter=0\noindent#1\par}
% A fragment whose own spacing is doing the aligning -- a little table
% inside a comment. Kept as it was written, which is the point of it.
% #1 the size that fits it, #2 how far in it starts (mkregs.py chooses both)
\newenvironment{reglit}[2]
  {\VerbatimEnvironment\par\vspace{1pt}%
   \begin{Verbatim}[fontsize=#1,xleftmargin=#2,samepage=false]}
  {\end{Verbatim}\vspace{1pt}}
% A form to copy: the issue template on the Filing an Issue page. Neutral
% grey, because it is neither something the machine printed nor something
% you type at it -- it is a page to fill in.
\newenvironment{form}
  {\VerbatimEnvironment\begin{tcolorbox}[colback=kgrey!8!white,
     colframe=kgrey!55!white,boxrule=0.6pt,left=6pt,right=4pt,top=4pt,
     bottom=4pt,breakable]\begin{Verbatim}[fontsize=\small]}
  {\end{Verbatim}\end{tcolorbox}}
