1 REM EXPRESSION BENCHMARK: THIS MACHINE'S OWN, NO HISTORICAL PEER
4 PRINT CHR$(12);"EXPRESSIONS: 20000 EVALUATIONS OF A+B*C-D/E+I*0.001"
5 PRINT "THE EXPRESSION COMPILER TURNS IT INTO A MATH-UNIT LIST ONCE, THEN REPLAYS IT."
6 PRINT
20 T=PEEK(54541)+256*PEEK(54542)
30 A=0:B=1.5:C=2.5:D=3:E=7
40 FOR I=1 TO 20000
50 A=A+B*C-D/E+I*0.001
60 NEXT
70 T=PEEK(54541)+256*PEEK(54542)-T: IF T<0 THEN T=T+65536
80 SC=INT(T/0.6+0.5)/100
90 PRINT "A ="; A
100 PRINT "THIS MACHINE: ";MID$(STR$(SC),2);" SECONDS"
105 PRINT "COMPILED";PEEK(1051);" BAILED";PEEK(1052);" CACHE HITS";PEEK(1053)
110 PRINT
120 PRINT "FOR SCALE, THIS SAME PROGRAM ON THIS SAME MACHINE:"
130 PRINT "  INTERPRETED, MATH-UNIT FLOATS   6.46 S"
140 PRINT "  WITH THE EXPRESSION COMPILER    2.11 S (WHAT YOU JUST RAN)"
150 PRINT: PRINT "METRIC: TOTAL RUN TIME, SELF-TIMED."
900 PRINT: PRINT "ANY KEY...";
905 GET K$: IF K$="" THEN 905
910 IF PEEK(1039) THEN LOAD "BENCH.BAS"
