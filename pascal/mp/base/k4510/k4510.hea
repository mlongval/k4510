; K4510: the I/O page and the ROM's system calls (core/io.h, rom/crt0.s)

k4_vicky	= $D000		; VICKY video
k4_kbd		= $D100		; keyboard: next key (pops)
k4_kbdst	= $D101		; bit7 key waiting; bit0 shift, bit1 ctrl, bit2 alt
k4_dma		= $D200		; block DMA: SRC DST LEN CMD
k4_fs		= $D300		; the host filesystem
k4_sys		= $D500		; clock, RTC, frames ($D50D-$D50F), version
k4_seq		= $D5E0		; the sound sequencer: CH, AMP, PITCH, DUR (DUR queues the note)
k4_bank		= $D600		; bank registers
k4_math		= $D700		; the MATH unit
k4_tube		= $D800		; the Tube
k4_net		= $D900		; the N: device
k4_term		= $DA00		; JIM, the terminal: DATA
k4_term_st	= $DA01		; bit7 a reply byte waits
k4_term_rep	= $DA02		; the reply (pops)
k4_term_key	= $DA03		; a key code in -> its VT bytes out
k4_term_ctl	= $DA04		; 1 reset, 2 clear
k4_term_cx	= $DA09
k4_term_cy	= $DA0A
k4_term_fg	= $DA0B
k4_term_bg	= $DA0C
k4_term_flags	= $DA0E		; bit0 cursor shown

k4_chrout	= $FF80		; A = char
k4_chrin	= $FF83		; -> A, blocks
k4_getin	= $FF86		; -> A, 0 if none
k4_load		= $FF89		; name ptr $F0/$F1, dest $F2..$F5 -> A status, size $F6..$F9
k4_save		= $FF8C		; name ptr $F0/$F1, src $F2..$F5, len $F6..$F9 -> A status
k4_shell	= $FF8F		; A/X = pointer to a command line
k4_video	= $FF92		; the ROM's text mode and palette back
k4_args		= $FF95		; $F0/$F1 = the command tail, A = its length
