10 REM GRAPH3D - AN INTERACTIVE SURFACE PLOTTER, Z=F(X,Y) AS A WIREFRAME
20 REM ARROWS ROTATE, +/- ZOOM, 1-5 PICK THE SURFACE, Q QUITS
30 GRAPHICS 2
40 PALETTE 16,255,255,255:PALETTE 17,80,200,255:PALETTE 18,255,150,0
50 N=14:D=6:ST=2*D/N
60 DIM Z(14,14),SX(14,14),SY(14,14)
70 A=0.7:E=0.5:S=32:F=1
80 GOSUB 4000
100 REM ---- PROJECT AND DRAW ----
110 GCLS:PRINT CHR$(12)
115 GOSUB 3000
120 CA=COS(A):SA=SIN(A):CE=COS(E):SE=SIN(E)
130 FOR I=0 TO N:X=-D+I*ST
140 FOR J=0 TO N:Y=-D+J*ST
150 U=X*CA+Y*SA:V=-X*SA+Y*CA
160 SX(I,J)=320+S*U:SY(I,J)=240-S*(Z(I,J)*CE+V*SE)
170 NEXT:NEXT
200 FOR I=0 TO N:FOR J=1 TO N
210 LINE SX(I,J-1),SY(I,J-1),SX(I,J),SY(I,J),17
220 LINE SX(J-1,I),SY(J-1,I),SX(J,I),SY(J,I),18
230 NEXT:NEXT
400 REM ---- KEYS ----
410 GET K$:IF K$="" THEN 410
420 IF K$=CHR$(130) THEN A=A-0.25:GOTO 100
430 IF K$=CHR$(131) THEN A=A+0.25:GOTO 100
440 IF K$=CHR$(128) THEN E=E+0.15:GOTO 100
450 IF K$=CHR$(129) THEN E=E-0.15:GOTO 100
460 IF K$="+" THEN S=S*1.3:GOTO 100
470 IF K$="-" THEN S=S/1.3:GOTO 100
480 IF K$>="1" AND K$<="5" THEN F=VAL(K$):GOSUB 4000:GOTO 100
490 IF K$="Q" OR K$="q" THEN GRAPHICS 0:GOTO 990
500 GOTO 410
3000 F$="RIPPLE":IF F=2 THEN F$="SADDLE"
3010 IF F=3 THEN F$="EGGBOX"
3020 IF F=4 THEN F$="HILL"
3030 IF F=5 THEN F$="CONE"
3040 PRINT "F";F;" ";F$;"  ARROWS ROTATE  +/- ZOOM  1-5 SURFACE  Q QUIT"
3050 RETURN
4000 REM ---- COMPUTE THE SURFACE ----
4010 PRINT CHR$(12);"COMPUTING ";:GOSUB 3000
4020 FOR I=0 TO N:X=-D+I*ST
4030 FOR J=0 TO N:Y=-D+J*ST
4040 R=SQR(X*X+Y*Y)
4050 IF F=1 THEN Z(I,J)=4*SIN(R)/(1+R/4)
4060 IF F=2 THEN Z(I,J)=(X*X-Y*Y)/8
4070 IF F=3 THEN Z(I,J)=2*COS(X)*COS(Y)
4080 IF F=4 THEN Z(I,J)=6*EXP(-(X*X+Y*Y)/8)
4090 IF F=5 THEN Z(I,J)=5-R
4100 NEXT:NEXT
4110 RETURN
990 IF PEEK(1039) THEN LOAD "DEMOS.BAS"
