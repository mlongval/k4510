#!/bin/sh
# k4510-connect [user@]host [command ...] -- a shell on another computer, for
# the Terminal screen (TERMINAL.CFG): mosh if it can, else ssh.
#
# mosh echoes what you type at once and keeps the session through a network
# that drops or changes (the hotspot, then home Wi-Fi, a closed lid); ssh is
# the fallback when mosh is missing here, or cannot start a session there
# (no mosh-server, its UDP ports closed).  Doc, 2026-10-07.
# (It was k4510-remote for an afternoon: that name is tools/k4510-remote's,
# which drives a K4510 from another computer, and the ! shell found that one.)
#
#   k4510-connect doc@ubuntu-s1 tmux new -A -s k4510
#
# A mosh that fails, fails within seconds: one that ran for longer than
# QUICK seconds was a session, and its exit status is the session's, so
# there is no fallback then.  K4510_REMOTE=ssh skips mosh.
#
# The other side is told this is a K4510 (K4510_CLIENT=1 in the session's
# environment): mosh calls every terminal xterm-256color, so a tmux theme or a
# prompt that picks the K4510's plain ASCII look by TERM=xterm-color has this
# to go by instead.
QUICK=15
[ $# -ge 1 ] || { echo "usage: k4510-connect [user@]host [command ...]" >&2; exit 2; }
target=$1; shift
if [ "${K4510_REMOTE:-}" != ssh ] && command -v mosh >/dev/null 2>&1; then
    t0=$(date +%s)
    if [ $# -gt 0 ]; then mosh --predict=adaptive "$target" -- env K4510_CLIENT=1 "$@"
    else mosh --predict=adaptive "$target" -- sh -c 'export K4510_CLIENT=1; exec "${SHELL:-/bin/sh}" -l'; fi
    rc=$?
    [ $rc -eq 0 ] && exit 0
    [ $(( $(date +%s) - t0 )) -ge $QUICK ] && exit $rc
    echo "k4510-connect: mosh did not connect -- ssh instead" >&2
fi
if [ $# -gt 0 ]; then exec ssh -t "$target" env K4510_CLIENT=1 "$@"; fi
exec ssh -t "$target" 'export K4510_CLIENT=1; exec "${SHELL:-/bin/sh}" -l'
