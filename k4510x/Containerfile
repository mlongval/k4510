# K4510x as a podman container (k4510x/podman.sh builds and runs this).
# The same Debian as the stick, minus the kernel, firmware and network
# stack; the machine built inside; the k4510 user with passwordless sudo,
# as on the stick.  What the container can see of the host is decided by
# podman.sh's mounts, not here: this file knows nothing about the host.
#
# libdecor: on GNOME's Wayland a window gets no title bar unless it draws
# its own, and SDL draws one only where libdecor is found at run time.  The
# stick never needs it (kmsdrm, no windows); this flavour is the one that
# lives on a desktop, so it is here and not in the package list.  Doc,
# hdieu, 2026-09-08: "no Gnome window around emulator".
FROM docker.io/library/debian:trixie
ARG UID=1000
ARG PKGS
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
        sudo ca-certificates tzdata libgl1-mesa-dri libegl1 libpipewire-0.3-0 libpulse0 \
        libdecor-0-0 libdecor-0-plugin-1-gtk \
        $PKGS \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -f input && groupadd -f render \
    && useradd -m -u $UID -s /bin/bash -G audio,video,input,render k4510 \
    && echo 'k4510 ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/k4510x-user && chmod 440 /etc/sudoers.d/k4510x-user
USER k4510
WORKDIR /home/k4510
COPY --chown=k4510:k4510 . /home/k4510/k4510
RUN cd ~/k4510 && find core sdl -name '*.d' -delete \
    && make -j"$(nproc)" ACME=/usr/bin/acme sdl/k4510 rom/kernal.bin rom/wozmon.bin rom/demo.bin cpm/runcpm \
    && (make -C tube || echo "the Tube did not build; everything else did") \
    && mkdir -p ~/k4510/fs/SHARE
# The compilers beside the machine, as on the stick (build-live.sh): Mad Pascal
# and MADS at the paths the Makefile defaults to, the K4510 target grafted in,
# the C startup objects built.  PAS name / CC name at the prompt run
# tools/k4510-pas and tools/k4510-cc through `!`, so tools/ goes on PATH.
RUN mkdir -p ~/Projects/neo6502_dev && cd ~/Projects/neo6502_dev \
    && git clone -q --depth 1 https://github.com/tebe6502/Mad-Pascal.git \
    && git clone -q --depth 1 https://github.com/tebe6502/Mad-Assembler.git \
    && (cd Mad-Assembler && fpc -Mdelphi -O2 mads.pas >/dev/null) \
    && cd ~/k4510 && python3 pascal/install.py ~/Projects/neo6502_dev/Mad-Pascal >/dev/null \
    && make demo/prg0.o demo/romcalls.o \
    && mkdir /tmp/prove && cd /tmp/prove && cp ~/k4510/demo/pas/hello.pas ~/k4510/demo/sieve.c . \
    && PATH=~/k4510/tools:$PATH k4510-pas hello && PATH=~/k4510/tools:$PATH k4510-cc sieve \
    && cd / && rm -rf /tmp/prove
ENV PATH=/home/k4510/k4510/tools:/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games
# the settings a K4510x starts with (podman.sh copies your own over these if you have some)
RUN printf 'version = 2\ncpu.auto = on\nterm.bands = on\n' > ~/k4510/k4510.cfg
ENV SHELL=/bin/bash TERM=ansi TZ=America/Toronto
ENTRYPOINT ["/bin/sh", "-c", "cd ~/k4510 && exec ./sdl/k4510 --host-shell"]
