# CONFIGURATION FILE FOR SETUPCON -- see console-setup(5).
#
# K4510: the Linux consoles (Ctrl+Alt+F2..F6, and tty1 before the machine
# takes it) wear the IBM VGA font at 24x43, so a 1920x1080 panel is 80x25 as
# a PC's text screen was.  Doc, 2026-09-12.  The font is generated by
# data/mkconsolefont.py from the kernel's font_8x16.c; on a panel of another
# size the cell stays 24x43 and the count follows (1366x768 is 56x17).

ACTIVE_CONSOLES="/dev/tty[1-6]"

CHARMAP="UTF-8"

CODESET="guess"
FONT="/usr/share/consolefonts/K4510-VGA24x43.psf"

VIDEOMODE=
