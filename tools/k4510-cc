#!/bin/sh
# k4510-cc NAME[.c]   compile a C program into NAME.prg beside it
#
# The on-machine half of "self-hosted C": at the machine's prompt
#   CC SIEVE           (a K/OS word: it runs `!k4510-cc SIEVE`)
# compiles SIEVE.C in the current directory with cc65 and leaves SIEVE.prg
# beside it.  NAME may be a path, and a machine path (/LANG/C/SIEVE) is
# found under K4510_ROOT, the machine's fs/ -- which is how VI's :make
# compiles the file it has open wherever you are standing.  The same recipe
# as the Makefile's fs/SYSTEM/BIN/%.prg rule: cc65 -O for the 65C02, ca65,
# ld65 with demo/prg.cfg (a .prg loaded at $6000, its own zero page and C
# stack) and the two startup objects demo/prg0.o and demo/romcalls.o.
# #include "k4510.h" and "far.h" resolve to demo/.
#
# The messages go to the screen, and -- one line each, in the form
# tools/k4510-errfmt describes -- to /SYSTEM/LOG/MAKE.ERR, which VI reads.
# K4510 names the checkout (default: the one this script lives in); cc65
# must be on PATH.  Exit status is the compiler's.
set -u
K4510=${K4510:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
[ $# -ge 1 ] || { echo "usage: k4510-cc NAME[.c]   (compiles NAME.c into NAME.prg beside it)" >&2; exit 2; }
ERR=
[ -n "${K4510_ROOT:-}" ] && [ -d "$K4510_ROOT/SYSTEM/LOG" ] && ERR=$K4510_ROOT/SYSTEM/LOG/MAKE.ERR
[ -n "$ERR" ] && : > "$ERR"
fail() { echo "$1" >&2; [ -n "$ERR" ] && echo "-:0:0:E:$1" >> "$ERR"; exit "${2:-1}"; }
command -v cc65 >/dev/null 2>&1 || fail "k4510-cc: no cc65 on PATH" 2
for f in demo/prg.cfg demo/k4510.h demo/prg0.s demo/romcalls.s; do
    [ -f "$K4510/$f" ] || fail "k4510-cc: $K4510/$f missing (K4510 must name the checkout)" 2
done

src=$1
case "$src" in /*) [ -n "${K4510_ROOT:-}" ] && src=$K4510_ROOT$src ;; esac
cd "$(dirname "$src")" 2>/dev/null || fail "k4510-cc: $(dirname "$1"): no such directory"
src=$(basename "$src")
case "$src" in *.c|*.C) ;; *) src="$src.c" ;; esac
if [ ! -f "$src" ]; then
    f=$(find . -maxdepth 1 -iname "$src" | head -1)
    [ -n "$f" ] || fail "k4510-cc: $src: no such file"
    src=${f#./}
fi
base=${src%.*}
out=$(printf %s "$base" | tr A-Z a-z).prg

tmp=$(mktemp -d "${TMPDIR:-/tmp}/k4510-cc.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
# the messages, one line each, to MAKE.ERR and -- readably -- to the screen
report() {
    "$K4510/tools/k4510-errfmt" < "$tmp/log" > "$tmp/err"
    [ -n "$ERR" ] && cat "$tmp/err" >> "$ERR"
    awk -F: '{ t = $0; sub(/^[^:]*:[^:]*:[^:]*:[^:]*:/, "", t)
               w = $4 == "E" ? "Error: " : $4 == "W" ? "Warning: " : ""
               print ($1 == "-" ? "" : $1 ":" $2 ": ") w t }' "$tmp/err" >&2
}
# the two startup objects: use the checkout's if make has built them, else
# assemble them here (a fresh checkout has only the .s)
for o in prg0 romcalls; do
    if [ -f "$K4510/demo/$o.o" ]; then cp "$K4510/demo/$o.o" "$tmp/$o.o"
    else ca65 --cpu 65c02 -o "$tmp/$o.o" "$K4510/demo/$o.s" || exit 1; fi
done
# k4510.h defines its helpers static, so every program that skips one gets a
# "defined but never used" warning; those are the header's, not the user's
cc65 -O -t none --cpu 65c02 -I "$K4510/demo" -o "$tmp/prog.s" "$src" 2>&1 | grep -v "is defined but never used" > "$tmp/log"
st=0; [ -s "$tmp/prog.s" ] && grep -q ': Error: ' "$tmp/log" && st=1
[ -s "$tmp/prog.s" ] || st=1
if [ $st -eq 0 ]; then
    ca65 --cpu 65c02 -o "$tmp/prog.o" "$tmp/prog.s" >> "$tmp/log" 2>&1 || st=$?
fi
if [ $st -eq 0 ]; then
    ld65 -C "$K4510/demo/prg.cfg" -o "$tmp/prog.prg" "$tmp/prg0.o" "$tmp/romcalls.o" "$tmp/prog.o" none.lib >> "$tmp/log" 2>&1 || st=$?
fi
report
[ $st -eq 0 ] || exit $st
cp "$tmp/prog.prg" "$out" || exit 1
msg="$out: $(wc -c < "$out") bytes"
echo "$msg"
[ -n "$ERR" ] && echo "-:0:0:I:$msg" >> "$ERR"
exit 0
