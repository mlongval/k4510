100 REM LINES AND POINTS -- X16 BASIC, VERA
110 REM 500 LINES ACROSS A 320X240 SCREEN, THEN 5000 POINTS (PSET)
120 PRINT "500 LINES AND 5000 POINTS, 320X240, X16 BASIC"
130 SCREEN 128
200 T=TI
210 FOR I=0 TO 499
220 Y=I-240*INT(I/240)
230 LINE 0,Y,319,239-Y,1+(I AND 15)
240 NEXT
250 T1=TI-T
300 T=TI
310 FOR Y=0 TO 49
320 FOR X=0 TO 99
330 PSET X*3,Y*4,1+(X AND 15)
340 NEXT:NEXT
350 T2=TI-T
360 POKE 40885,2:REM $9FB5: RECORD A FEW GIF FRAMES FOR THE RECORD
362 T=TI
364 IF TI-T<20 THEN 364
366 POKE 40885,0
370 SCREEN 0
400 PRINT "RESULT LINES";T1/60;"S"
410 PRINT "RESULT POINTS";T2/60;"S"
420 PRINT "DONE"
