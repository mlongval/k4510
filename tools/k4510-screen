#!/bin/sh
# k4510-screen -- the running K4510's text screen, as text.
#
#     k4510-screen            CP437, as the machine has it (what k4510-remote reads)
#     k4510-screen --utf8     converted, for a terminal
#
# Sends the emulator SIGUSR2; it writes shots/screen.txt in its own directory
# -- every row of the glass, the status bands included, trailing blanks
# trimmed, blank rows kept -- and this prints it.  The F7 menu is drawn over
# the picture, not into the text: a first line says when it is open.  With
# k4510-type and k4510-shot, the machine read and driven from another
# computer (Doc, 2026-09-14).
pid=$(pgrep -nx k4510) || { echo "k4510-screen: no emulator running" >&2; exit 1; }
f=$(readlink "/proc/$pid/cwd")/shots/screen.txt
before=$(stat -c %i "$f" 2>/dev/null)          # the emulator renames a new file in: a new inode
kill -USR2 "$pid" || exit 1
i=0
while [ $i -lt 50 ]; do                         # five seconds: a frame is 17 ms, unless paused hard
    now=$(stat -c %i "$f" 2>/dev/null)
    if [ -n "$now" ] && [ "$now" != "$before" ]; then
        if [ "$1" = "--utf8" ]; then iconv -f CP437 -t UTF-8 "$f"; else cat "$f"; fi
        exit 0
    fi
    sleep 0.1; i=$((i + 1))
done
echo "k4510-screen: no screen came (an emulator from before 2026-09-14?)" >&2
exit 1
