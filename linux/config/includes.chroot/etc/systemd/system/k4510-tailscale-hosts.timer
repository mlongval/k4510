[Unit]
Description=Keep /etc/hosts in step with the tailnet

[Timer]
# Once a minute after boot, so a machine that joins the tailnet while the Dell
# is running is reachable by name a minute later; then every five minutes,
# which costs one local query to tailscaled and nothing on the network.
OnBootSec=30s
# Every minute, not five: at 30 s after boot tailscaled had no peers yet, the
# block came out with one name, and the radio could not find the server until
# the next run (Doc, 2026-09-17, "first try -> nothing").  It is one rename.
OnUnitActiveSec=1min
AccuracySec=30s

[Install]
WantedBy=timers.target
